<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>HERMANOS RADIO (single file) — listen to the world</title>
<meta name="description" content="Slide across a flat map of the world, tap a light, hear a radio station from that exact spot on Earth.">
<meta name="theme-color" content="#04070d">
<meta name="author" content="Tom Jiji">
<meta name="copyright" content="© 2026 Tom Jiji">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='13' fill='none' stroke='%233ff0a5' stroke-width='2'/%3E%3Ccircle cx='16' cy='16' r='3.5' fill='%233ff0a5'/%3E%3C/svg%3E">
<style>
:root{
  --mint:#3ff0a5;
  --mint-2:#8bf7cd;
  --cyan:#49c9f2;
  --ink:#e9f6f2;
  --muted:#93a9a8;
  --muted-2:#6d8381;
  --panel:rgba(10,17,26,.74);
  --panel-solid:rgba(8,14,21,.94);
  --line:rgba(126,240,196,.14);
  --line-2:rgba(126,240,196,.28);
  --shadow:0 24px 60px rgba(0,0,0,.55);
  --r:18px;
  --ease:cubic-bezier(.22,.61,.36,1);
}

*{box-sizing:border-box}
[hidden]{display:none !important}
html,body{height:100%}
body{
  margin:0;
  background:
    radial-gradient(1200px 800px at 72% 18%, #0a1725 0%, rgba(6,11,18,0) 62%),
    radial-gradient(900px 700px at 12% 88%, #08161a 0%, rgba(4,8,13,0) 60%),
    #04070d;
  color:var(--ink);
  font:15px/1.5 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Inter,"Helvetica Neue",Arial,sans-serif;
  overflow:hidden;
  -webkit-font-smoothing:antialiased;
  overscroll-behavior:none;
}
#map{position:fixed;inset:0;width:100%;height:100%;display:block;touch-action:none;cursor:grab}
#map.dragging{cursor:grabbing}
#map.pointing{cursor:pointer}
#vignette{
  position:fixed;inset:0;pointer-events:none;
  background:radial-gradient(140% 120% at 50% 50%, rgba(0,0,0,0) 68%, rgba(0,0,0,.42) 100%);
}
#ui{position:fixed;inset:0;pointer-events:none;display:block}
#ui > *{pointer-events:auto}
#ui .tooltip,#ui .toast,#ui .hint,#ui .map-sign,#ui .copyright,#ui .sat-credit{pointer-events:none}
.hint{pointer-events:none}

h1,h2,h3,p{margin:0}
button{font:inherit;color:inherit;background:none;border:0;cursor:pointer}
a{color:inherit}
kbd{
  font:600 11px/1 ui-monospace,SFMono-Regular,Menlo,monospace;
  padding:4px 6px;border-radius:6px;
  background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.12);
  color:var(--mint-2);
}
.eyebrow{
  font-size:10.5px;letter-spacing:.18em;text-transform:uppercase;color:var(--muted-2);
}

/* ---------------------------------------------------------------- top bar */
.bar{
  position:absolute;top:0;left:0;right:0;
  display:flex;align-items:center;gap:14px;
  padding:16px clamp(14px,2.4vw,30px);
  background:linear-gradient(to bottom, rgba(4,7,13,.86), rgba(4,7,13,0));
}
.brand{display:flex;align-items:center;gap:10px;color:var(--mint);text-decoration:none;flex:0 0 auto}
.brand svg{width:30px;height:30px;filter:drop-shadow(0 0 10px rgba(63,240,165,.4))}
.brand-name{font-size:15px;letter-spacing:.22em;font-weight:600;color:var(--ink)}
.brand-name b{font-weight:400;color:var(--mint)}

.search{
  position:relative;flex:1 1 420px;max-width:560px;margin:0 auto;
  display:flex;align-items:center;gap:10px;
  padding:0 12px;height:46px;border-radius:14px;
  background:var(--panel);border:1px solid var(--line);
  backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);
  transition:border-color .2s var(--ease),box-shadow .2s var(--ease);
}
.search:focus-within{border-color:var(--line-2);box-shadow:0 0 0 4px rgba(63,240,165,.07)}
.search > svg{width:19px;height:19px;color:var(--muted-2);flex:0 0 auto}
.search input{
  flex:1;min-width:0;background:none;border:0;outline:0;color:var(--ink);
  font-size:14.5px;letter-spacing:.01em;
}
.search input::placeholder{color:var(--muted-2)}
.search input::-webkit-search-cancel-button{display:none}
.suggest{
  position:absolute;top:calc(100% + 8px);left:0;right:0;
  background:var(--panel-solid);border:1px solid var(--line);border-radius:14px;
  box-shadow:var(--shadow);overflow:hidden;max-height:min(52vh,420px);overflow-y:auto;
  backdrop-filter:blur(18px);
}
.suggest button{
  display:flex;align-items:center;gap:10px;width:100%;text-align:left;
  padding:10px 13px;border-bottom:1px solid rgba(255,255,255,.05);
}
.suggest button:last-child{border-bottom:0}
.suggest button:hover,.suggest button.active{background:rgba(63,240,165,.09)}
.suggest .s-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.suggest .s-meta{font-size:12px;color:var(--muted-2);flex:0 0 auto}
.suggest .s-kind{
  font-size:9.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--mint);
  border:1px solid var(--line-2);border-radius:999px;padding:3px 7px;flex:0 0 auto;
}
.tools{display:flex;gap:8px;flex:0 0 auto}
.icon{
  width:44px;height:44px;border-radius:13px;display:grid;place-items:center;
  background:var(--panel);border:1px solid var(--line);color:var(--ink);
  backdrop-filter:blur(18px);
  transition:transform .16s var(--ease),border-color .2s,color .2s,background .2s;
}
.icon svg{width:21px;height:21px}
.icon:hover{border-color:var(--line-2);color:var(--mint-2);transform:translateY(-1px)}

.icon.small{width:34px;height:34px;border-radius:10px;background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.08)}
.icon.small svg{width:16px;height:16px}
/* recording: the dot turns red and the clock runs */
#btn-rec.recording{color:#ff7b7b;border-color:rgba(255,110,110,.55);background:rgba(255,80,80,.12);
  animation:rec-pulse 1.7s ease-in-out infinite}
@keyframes rec-pulse{
  0%,100%{box-shadow:inset 0 0 0 1px rgba(255,110,110,.20),0 0 10px rgba(255,80,80,.22)}
  50%{box-shadow:inset 0 0 0 1px rgba(255,110,110,.38),0 0 20px rgba(255,80,80,.48)}}
.rec-time{align-self:center;font-size:11.5px;font-variant-numeric:tabular-nums;letter-spacing:.05em;
  color:#ffdede;padding:2px 8px;border-radius:999px;background:rgba(255,80,80,.14);
  border:1px solid rgba(255,110,110,.30)}

.icon.active{border-color:rgba(90,240,190,.55);color:var(--mint-2);background:rgba(60,220,180,.10);
  box-shadow:inset 0 0 0 1px rgba(90,240,190,.18),0 0 18px rgba(60,220,180,.18)}

/* what the satellite layer is showing, and who to credit for it */
.sat-credit{position:absolute;bottom:64px;left:50%;transform:translateX(-50%);
  font-size:11.5px;letter-spacing:.02em;color:rgba(214,230,240,.72);
  background:rgba(6,16,22,.62);border:1px solid rgba(120,200,190,.18);
  padding:5px 11px;border-radius:999px;white-space:nowrap;backdrop-filter:blur(6px);z-index:3}
@media (max-width:760px){.sat-credit{bottom:78px;font-size:10.5px;max-width:92vw;overflow:hidden;text-overflow:ellipsis}}
#btn-fav.on{color:var(--mint);border-color:var(--line-2);background:rgba(63,240,165,.12)}
#btn-fav.on svg path{fill:var(--mint)}

/* ---------------------------------------------------------------- panel */
.panel{
  position:absolute;top:78px;right:clamp(14px,2.4vw,30px);width:352px;
  max-height:calc(100vh - 210px);
  display:flex;flex-direction:column;
  background:var(--panel);border:1px solid var(--line);border-radius:var(--r);
  box-shadow:var(--shadow);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  overflow:hidden;animation:slide-in .28s var(--ease);
}
@keyframes slide-in{from{opacity:0;transform:translateX(14px)}to{opacity:1;transform:none}}
.panel-head{display:flex;align-items:flex-start;gap:12px;padding:16px 16px 6px}
.panel-head h2{font-size:18px;font-weight:600;letter-spacing:-.01em;margin-top:3px}
.panel-head .icon{margin-left:auto}
.panel-sub{padding:0 16px 10px;font-size:12.5px;color:var(--muted-2)}
.list{list-style:none;margin:0;padding:0 8px 8px;overflow-y:auto;flex:1;min-height:0}
.list li{margin:2px 0}
.row{
  display:flex;align-items:center;gap:11px;width:100%;text-align:left;
  padding:9px 10px;border-radius:12px;transition:background .16s;
}
.row:hover{background:rgba(255,255,255,.05)}
.row.playing{background:rgba(63,240,165,.11)}
.row .dot{
  width:9px;height:9px;border-radius:50%;flex:0 0 auto;background:var(--mint);
  box-shadow:0 0 10px rgba(63,240,165,.85);
}
.row.dead .dot{background:#6d8381;box-shadow:none}
.row-main{flex:1;min-width:0}
.row-name{display:block;font-size:13.6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row-meta{display:block;font-size:11.5px;color:var(--muted-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.row .go{
  width:26px;height:26px;border-radius:8px;display:grid;place-items:center;flex:0 0 auto;
  color:var(--muted);opacity:0;transition:opacity .16s,color .16s;
}
.row:hover .go,.row.playing .go{opacity:1;color:var(--mint)}
.row .go svg{width:13px;height:13px}
.panel-foot{padding:10px 16px 14px;border-top:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;gap:8px}
.ghost{
  width:100%;padding:10px;border-radius:11px;font-size:13px;color:var(--mint-2);
  border:1px dashed var(--line-2);background:rgba(63,240,165,.05);
}
.ghost:hover{background:rgba(63,240,165,.11)}
.ghost[disabled]{opacity:.6}
.panel-note{font-size:11.5px;color:var(--muted-2)}
.list .empty{padding:20px 12px;font-size:13px;color:var(--muted-2);text-align:center}

/* ---------------------------------------------------------------- player card */
.card{
  position:absolute;left:clamp(14px,2.4vw,30px);bottom:26px;width:min(430px,calc(100vw - 40px));
  display:flex;gap:14px;padding:15px;border-radius:var(--r);
  background:var(--panel);border:1px solid var(--line);box-shadow:var(--shadow);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  animation:rise .32s var(--ease);
}
@keyframes rise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
.card-art{
  width:66px;height:66px;border-radius:14px;flex:0 0 auto;overflow:hidden;
  display:grid;place-items:center;
  background:linear-gradient(140deg,#123a30,#0b2230);border:1px solid var(--line);
  font-weight:700;letter-spacing:.06em;color:var(--mint-2);font-size:19px;
}
.card-art img{width:100%;height:100%;object-fit:cover;display:block}
.card-body{flex:1;min-width:0}
.card-body h2{
  font-size:17.5px;font-weight:600;letter-spacing:-.01em;line-height:1.25;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
}
#card-name{text-decoration:none;display:block}
.card-tags{margin-top:5px;display:flex;flex-wrap:wrap;gap:5px}
.card-tags span{
  font-size:10.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--mint-2);
  background:rgba(63,240,165,.08);border:1px solid var(--line);border-radius:999px;padding:2.5px 8px;
}
.card-meta{margin-top:6px;font-size:11.5px;color:var(--muted-2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.controls{display:flex;align-items:center;gap:10px;margin-top:11px}
.play{
  width:42px;height:42px;border-radius:50%;flex:0 0 auto;display:grid;place-items:center;
  background:var(--mint);color:#04140d;box-shadow:0 0 0 0 rgba(63,240,165,.5);
  transition:transform .15s var(--ease),box-shadow .3s;
}
.play:hover{transform:scale(1.06)}
.play svg{width:19px;height:19px}
.play .i-pause{display:none}
.card.playing .play .i-play{display:none}
.card.playing .play .i-pause{display:block}
.card.loading .play{background:var(--cyan)}
.eq{display:flex;align-items:flex-end;gap:3px;height:22px;width:40px;flex:0 0 auto}
.eq i{flex:1;background:linear-gradient(to top,var(--mint),var(--mint-2));border-radius:2px;height:15%;opacity:.35}
.eq[data-state="playing"] i{opacity:1;animation:bounce .9s ease-in-out infinite}
.eq[data-state="playing"] i:nth-child(2){animation-delay:.15s}
.eq[data-state="playing"] i:nth-child(3){animation-delay:.32s}
.eq[data-state="playing"] i:nth-child(4){animation-delay:.48s}
.eq[data-state="playing"] i:nth-child(5){animation-delay:.66s}
.eq[data-state="paused"] i{opacity:.5}
@keyframes bounce{0%,100%{height:18%}35%{height:100%}62%{height:46%}}
.vol{display:flex;align-items:center;gap:6px;margin-left:auto}
#volume{
  -webkit-appearance:none;appearance:none;width:78px;height:4px;border-radius:3px;
  background:linear-gradient(to right,var(--mint) var(--v,80%),rgba(255,255,255,.16) var(--v,80%));
  outline:0;cursor:pointer;
}
#volume::-webkit-slider-thumb{-webkit-appearance:none;width:13px;height:13px;border-radius:50%;background:#fff;box-shadow:0 0 8px rgba(63,240,165,.7)}
#volume::-moz-range-thumb{width:13px;height:13px;border:0;border-radius:50%;background:#fff}
.vol.muted #vol-wave{opacity:.2}

/* ---------------------------------------------------------------- bubbles */
.tooltip{
  position:absolute;z-index:5;transform:translate(-50%,-140%);
  padding:7px 11px;border-radius:11px;pointer-events:none;max-width:280px;
  background:var(--panel-solid);border:1px solid var(--line-2);box-shadow:var(--shadow);
}
.tooltip b{display:block;font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.tooltip span{display:block;font-size:11.5px;color:var(--muted-2)}
.toast{
  position:absolute;left:50%;bottom:96px;transform:translateX(-50%);
  padding:11px 16px;border-radius:13px;font-size:13.5px;max-width:min(520px,90vw);text-align:center;
  background:var(--panel-solid);border:1px solid var(--line-2);box-shadow:var(--shadow);
  animation:rise .24s var(--ease);
}
.toast.warn{border-color:rgba(255,180,90,.4);color:#ffd9a3}
.hint{
  position:absolute;left:50%;bottom:14px;transform:translateX(-50%);
  display:flex;align-items:center;gap:12px;
  font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--muted-2);
}
.hint i{width:3px;height:3px;border-radius:50%;background:var(--muted-2);opacity:.6}
/* signature on the map, upper corner */
.map-sign{
  position:absolute; top:86px; left:clamp(14px,2.4vw,30px);
  padding-left:11px; border-left:2px solid rgba(63,240,165,.45);
  font:600 11px/1 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  letter-spacing:.34em; text-transform:uppercase;
  color:var(--mint-2); opacity:.55;
  text-shadow:0 0 14px rgba(63,240,165,.4);
  pointer-events:none; user-select:none;
}
.copyright{
  position:absolute;right:clamp(14px,2.4vw,30px);bottom:15px;
  font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted-2);opacity:.7;pointer-events:none;
}
.copyright-line{opacity:.85;letter-spacing:.02em}

/* ---------------------------------------------------------------- overlays */
.modal{
  position:absolute;inset:0;display:grid;place-items:center;padding:22px;
  background:rgba(2,5,9,.72);backdrop-filter:blur(6px);animation:fade .2s var(--ease);
}
@keyframes fade{from{opacity:0}to{opacity:1}}
.modal-box{
  position:relative;max-width:520px;width:100%;padding:28px;border-radius:22px;
  background:var(--panel-solid);border:1px solid var(--line);box-shadow:var(--shadow);
  max-height:85vh;overflow-y:auto;
}
.modal-box h2{font-size:23px;font-weight:600;letter-spacing:-.02em;margin-bottom:12px}
.modal-box p{font-size:14px;color:#c7d8d5;margin-bottom:14px}
.modal-box .keys{list-style:none;margin:0 0 16px;padding:0;display:flex;flex-direction:column;gap:9px;font-size:13.5px;color:#c7d8d5}
.modal-box .keys li{display:flex;flex-wrap:wrap;align-items:center;gap:7px 10px}
.modal-box .keys kbd{min-width:58px;flex:0 0 auto;text-align:center}
.credit{font-size:12px;color:var(--muted-2)!important}
.credit a{color:var(--mint-2)}
.modal-x{position:absolute;top:16px;right:16px}

.boot{
  position:absolute;inset:0;display:grid;place-content:center;justify-items:center;gap:14px;
  background:radial-gradient(700px 500px at 50% 45%,#081420,#03060b 70%);
  transition:opacity .5s var(--ease);text-align:center;padding:24px;
}
.boot[hidden]{display:none}
.boot.done{opacity:0;pointer-events:none}
.boot-map{position:relative;width:96px;height:56px}
.boot-map i{
  position:absolute;inset:0;border-radius:8px;border:1.5px solid rgba(63,240,165,.35);
  border-top-color:var(--mint);animation:spin 1.6s linear infinite;
}
.boot-map i:nth-child(2){inset:11px 22px;border-color:rgba(73,201,242,.3);border-bottom-color:var(--cyan);animation-duration:2.3s;animation-direction:reverse}
.boot-map i:nth-child(3){inset:22px 44px;border-color:rgba(63,240,165,.3);border-right-color:var(--mint);animation-duration:1.9s}
@keyframes spin{to{transform:rotate(360deg)}}
#boot-text{font-size:13.5px;letter-spacing:.16em;text-transform:uppercase;color:var(--mint-2)}
#boot-sub{font-size:12.5px;color:var(--muted-2);max-width:420px}

/* ---------------------------------------------------------------- responsive */
@media (max-width:1000px){
  .brand-name{display:none}
  .hint,.copyright{display:none}
}
@media (max-width:820px){
  .map-sign{top:126px;font-size:10px;letter-spacing:.24em;opacity:.5}
  .bar{padding:12px 14px;gap:10px;flex-wrap:wrap}
  .search{order:3;flex:1 1 100%;max-width:none;height:44px}
  .tools{margin-left:auto}
  .panel{
    top:auto;left:10px;right:10px;bottom:10px;width:auto;max-height:58vh;
    animation:rise .3s var(--ease);
  }
  .card{left:10px;right:10px;bottom:10px;width:auto;padding:12px}
  .card-art{width:54px;height:54px;border-radius:12px;font-size:16px}
  .card.has-panel{display:none}
  .toast{bottom:auto;top:96px}
  .icon{width:40px;height:40px}
  .vol{margin-left:0}
  #volume{width:60px}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
}

</style>
</head>
<body>

<canvas id="map" aria-label="Interactive flat map of radio stations"></canvas>
<div id="vignette"></div>

<div id="ui">

  <header class="bar">
    <a class="brand" href="#" id="brand" title="Back to a global view">
      <svg viewBox="0 0 32 32" aria-hidden="true">
        <circle cx="16" cy="16" r="12.4" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".55"/>
        <ellipse cx="16" cy="16" rx="5.4" ry="12.4" fill="none" stroke="currentColor" stroke-width="1.1" opacity=".4"/>
        <path d="M4 12.4h24M4 19.6h24" stroke="currentColor" stroke-width="1.1" opacity=".4"/>
        <circle cx="16" cy="16" r="2.9" fill="currentColor"/>
      </svg>
      <span class="brand-name">HERMANOS&nbsp;<b>RADIO</b></span>
    </a>

    <div class="search" id="searchwrap">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.4" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M15.8 15.8 20 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      <input id="search" type="search" placeholder="Search a city, country, station or genre…" autocomplete="off" spellcheck="false" aria-label="Search stations">
      <kbd>/</kbd>
      <div class="suggest" id="suggest" hidden></div>
    </div>

    <nav class="tools">
      <button class="icon" id="btn-random" title="Surprise me (R)" aria-label="Play a random station">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="8.4" cy="8.4" r="1.5" fill="currentColor"/><circle cx="15.6" cy="15.6" r="1.5" fill="currentColor"/><circle cx="15.6" cy="8.4" r="1.5" fill="currentColor"/><circle cx="8.4" cy="15.6" r="1.5" fill="currentColor"/></svg>
      </button>
      <button class="icon" id="btn-cycle" title="Cycle through stations (C)" aria-label="Cycle through stations">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19.6 12a7.6 7.6 0 1 1-2.2-5.3" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M19.9 4.6v4.2h-4.2" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/></svg>
