/* ------------------------------------------------------------------ map: scene */
/* The world is a flat equirectangular plane: 1 world unit = 1 degree of latitude.
   x runs -180 (west) .. 180 (east), y runs -90 (south) .. 90 (north), z only stacks
   layers. The camera is orthographic and looks straight down the -z axis, so panning
   is just moving the camera and zooming is narrowing its frustum. */
let renderer, scene, camera, mapPlane, oceanBackdrop, worldLines, stationPoints, geo, ringA, ringB;
let pointCount = 0;
const MAX_POINTS = 34000;
let attr = {};
let worldBuilt = false;
let mapHalfW = 180, mapHalfH = 90;      // visible half extents, in degrees

const MIN_ZOOM = 1, MAX_ZOOM = 40;      // 1 = whole world, 40 ≈ one city
let fitDegHeight = 186;                 // vertical degrees visible at zoom 1
function computeFit() {
  const aspect = window.innerWidth / Math.max(1, window.innerHeight);
  // landscape: the world's 360° width exactly fills the screen.
  // portrait: fit its 180° height (the grid keeps the map floating over deep water).
  fitDegHeight = aspect >= 1 ? 360 / aspect : 190;
}
const degViewHeight = (zoom) => fitDegHeight / clamp(zoom, MIN_ZOOM, MAX_ZOOM);
const degPerPixel = () => degViewHeight(state.view.zoom) / Math.max(1, window.innerHeight);
const v3 = (lat, lon, z = 0) => new THREE.Vector3(lon, lat, z);

function buildScene() {
  const canvas = $('map');
  renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'high-performance' });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
  if ('outputEncoding' in renderer && THREE.sRGBEncoding) renderer.outputEncoding = THREE.sRGBEncoding;

  scene = new THREE.Scene();
  camera = new THREE.OrthographicCamera(-1, 1, 1, -1, -1000, 1000);
  camera.position.set(0, 0, 100);
  scene.add(camera);

  // open water continues past the edges of the world, so panning never shows a void
  oceanBackdrop = new THREE.Mesh(new THREE.PlaneGeometry(2400, 1200),
    new THREE.MeshBasicMaterial({ color: 0x040a11 }));
  oceanBackdrop.position.set(0, 0, -0.3);
  scene.add(oceanBackdrop);

  // the world: ocean, land and frame painted once into a canvas texture
  mapPlane = new THREE.Mesh(new THREE.PlaneGeometry(360, 180),
    new THREE.MeshBasicMaterial({ transparent: true, depthWrite: false }));
  mapPlane.position.set(0, 0, -0.05);
  scene.add(mapPlane);

  // graticule every 15°
  const grat = [];
  for (let lat = -75; lat <= 75; lat += 15) {
    grat.push(new THREE.Vector3(-180, lat, 0.004), new THREE.Vector3(180, lat, 0.004));
  }
  for (let lon = -180; lon <= 180; lon += 15) {
    grat.push(new THREE.Vector3(lon, -90, 0.004), new THREE.Vector3(lon, 90, 0.004));
  }
  scene.add(new THREE.LineSegments(new THREE.BufferGeometry().setFromPoints(grat),
    new THREE.LineBasicMaterial({ color: 0x1d7a70, transparent: true, opacity: 0.15, depthWrite: false })));

  // coastlines, filled in from world.json
  geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.BufferAttribute(new Float32Array(6), 3));
  worldLines = new THREE.LineSegments(geo, new THREE.LineBasicMaterial({
    color: 0x9bffdd, transparent: true, opacity: 0.5, depthWrite: false, blending: THREE.AdditiveBlending
  }));
  scene.add(worldLines);

  // stations
  const pos = new Float32Array(MAX_POINTS * 3);
  const col = new Float32Array(MAX_POINTS * 3);
  const siz = new Float32Array(MAX_POINTS);
  const sel = new Float32Array(MAX_POINTS);
  const sol = new Float32Array(MAX_POINTS);
  const pgeo = new THREE.BufferGeometry();
  pgeo.setAttribute('position', new THREE.BufferAttribute(pos, 3).setUsage(THREE.DynamicDrawUsage));
  pgeo.setAttribute('acolor', new THREE.BufferAttribute(col, 3).setUsage(THREE.DynamicDrawUsage));
  pgeo.setAttribute('size', new THREE.BufferAttribute(siz, 1).setUsage(THREE.DynamicDrawUsage));
  pgeo.setAttribute('sel', new THREE.BufferAttribute(sel, 1).setUsage(THREE.DynamicDrawUsage));
  pgeo.setAttribute('sol', new THREE.BufferAttribute(sol, 1).setUsage(THREE.DynamicDrawUsage));
  attr = {
    position: pgeo.getAttribute('position'), color: pgeo.getAttribute('acolor'),
    size: pgeo.getAttribute('size'), sel: pgeo.getAttribute('sel'), sol: pgeo.getAttribute('sol')
  };
  stationPoints = new THREE.Points(pgeo, new THREE.ShaderMaterial({
    transparent: true, depthWrite: false, depthTest: true, blending: THREE.AdditiveBlending,
    uniforms: { uPx: { value: 520 }, uDpr: { value: renderer.getPixelRatio() }, uSat: { value: 0 } },
    vertexShader: `
      attribute vec3 acolor; attribute float size; attribute float sel; attribute float sol;
      varying vec3 vColor; varying float vSel; varying float vSol;
      uniform float uPx; uniform float uDpr;
      void main(){
        vColor = acolor; vSel = sel; vSol = sol;
        gl_PointSize = clamp(size * uPx, 2.0 * uDpr, 50.0 * uDpr);
        gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
      }`,
    fragmentShader: `
      varying vec3 vColor; varying float vSel; varying float vSol;
      uniform float uSat;
      void main(){
        vec2 d = gl_PointCoord - 0.5;
        float r = length(d);
        if (r > 0.5) discard;
        float a = smoothstep(0.5, 0.16, r);
        vec3 c = mix(vColor, vec3(1.0), vSel * 0.75);
        c = mix(c, vec3(1.0), smoothstep(0.30, 0.0, r) * 0.5);
        c += vec3(1.0, 0.82, 0.35) * vSol;
        if (uSat > 0.5) {                       // over imagery: a dark rim keeps the light readable
          float rim = smoothstep(0.30, 0.5, r);
          c = mix(c, vec3(0.02, 0.06, 0.07), rim);
          gl_FragColor = vec4(c, max(a * (0.9 + vSel), rim));
        } else {
          gl_FragColor = vec4(c, a * (0.9 + vSel * 1.0));
        }
      }`
  }));
  scene.add(stationPoints);

  // selection rings: unit geometry scaled to a constant screen size
  ringA = new THREE.Mesh(new THREE.RingGeometry(0.62, 1, 48), new THREE.MeshBasicMaterial({
    color: 0xffffff, transparent: true, opacity: 0.85, side: THREE.DoubleSide, depthWrite: false
  }));
  ringB = new THREE.Mesh(new THREE.RingGeometry(0.84, 1, 48), new THREE.MeshBasicMaterial({
    color: 0x3ff0a5, transparent: true, opacity: 0.4, side: THREE.DoubleSide, depthWrite: false
  }));
  ringA.visible = ringB.visible = false;
  scene.add(ringA, ringB);

  buildSatellite();
  computeFit();
  resize();
  window.addEventListener('resize', resize);
}

/* The painted land is gorgeous from above and blurry up close. So as you zoom in,
   the raster fades back and the vector coastline layer — which is resolution-free —
   takes over. High zoom ends up looking like a crisp line-art map. */
let lastStyleZoom = -1;
function updateMapStyle(zoom, force) {
  if (!force && Math.abs(zoom - lastStyleZoom) < 0.15) return;
  lastStyleZoom = zoom;
  const raster = zoom <= 5 ? 1 : clamp(1 - (zoom - 5) / 28 * 0.6, 0.4, 1);
  mapPlane.material.opacity = SAT.on ? 0 : raster;      // imagery replaces the painted map
  worldLines.material.opacity = SAT.on ? 0.7 : clamp(0.5 + Math.max(0, zoom - 3) * 0.028, 0.5, 0.95);
  // over bright imagery the additive coastline glow would vanish, so it turns solid
  worldLines.material.blending = SAT.on ? THREE.NormalBlending : THREE.AdditiveBlending;
  mapPlane.material.needsUpdate = true;
  worldLines.material.needsUpdate = true;
}

function updateCameraFrustum() {
  const v = state.view;
  const halfH = degViewHeight(v.zoom) / 2;
  const halfW = halfH * (window.innerWidth / Math.max(1, window.innerHeight));
  mapHalfH = halfH; mapHalfW = halfW;
  camera.left = -halfW; camera.right = halfW;
  camera.top = halfH; camera.bottom = -halfH;
  camera.position.set(v.lon, v.lat, 100);
  camera.updateProjectionMatrix();
  camera.updateMatrixWorld();
  camera.matrixWorldInverse.copy(camera.matrixWorld).invert();
}

/* keep the world on screen: no drifting off into empty space */
function clampView() {
  const v = state.view;
  const halfH = degViewHeight(v.zoom) / 2;
  const halfW = halfH * (window.innerWidth / Math.max(1, window.innerHeight));
  const lonLimit = Math.max(0, 180 - halfW * 0.6);
  const latLimit = Math.max(0, 90 - halfH * 0.6);
  v.lon = clamp(v.lon, -lonLimit, lonLimit); v.tLon = clamp(v.tLon, -lonLimit, lonLimit);
  v.lat = clamp(v.lat, -latLimit, latLimit); v.tLat = clamp(v.tLat, -latLimit, latLimit);
}

function resize() {
  const w = window.innerWidth, h = window.innerHeight;
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 1.6));
  renderer.setSize(w, h, false);
  computeFit();
  stationPoints.material.uniforms.uDpr.value = renderer.getPixelRatio();
  stationPoints.material.uniforms.uPx.value = 520 * renderer.getPixelRatio();
  clampView();
  updateCameraFrustum();
}

/* the whole world, painted once: ocean, land, coastal glow, frame */
function buildMapTexture(world) {
  const maxTex = (renderer.capabilities && renderer.capabilities.maxTextureSize) || 4096;
  const W = Math.min(4096, maxTex), H = W / 2;
  const cv = document.createElement('canvas');
  cv.width = W; cv.height = H;
  const g = cv.getContext('2d');
  const X = (lon) => ((lon + 180) / 360) * W;
  const Y = (lat) => ((90 - lat) / 180) * H;

  const og = g.createLinearGradient(0, 0, 0, H);
  og.addColorStop(0, '#061420');
  og.addColorStop(0.5, '#08202c');
  og.addColorStop(1, '#061420');
  g.fillStyle = og;
  g.fillRect(0, 0, W, H);

  // every country's rings in one path, holes punched by the even-odd rule
  g.beginPath();
  for (const shape of world.shapes) {
    for (const ring of shape) {
      for (let i = 0; i + 1 < ring.length; i += 2) {
        const x = X(ring[i + 1]), y = Y(ring[i]);
        if (i === 0) g.moveTo(x, y); else g.lineTo(x, y);
      }
      g.closePath();
    }
  }
  const lg = g.createLinearGradient(0, 0, 0, H);
  lg.addColorStop(0, '#0f3a3b');
  lg.addColorStop(0.55, '#0c3138');
  lg.addColorStop(1, '#0d3a3c');
  g.fillStyle = lg;
  g.fill('evenodd');

  // soft coastal halo so land reads at any zoom
  g.lineJoin = 'round';
  g.lineCap = 'round';
  g.shadowColor = 'rgba(63,240,165,0.45)';
  g.shadowBlur = Math.max(4, W / 640);
  g.strokeStyle = 'rgba(150,255,215,0.32)';
  g.lineWidth = Math.max(1.2, W / 2200);
  g.stroke();

  // the edge of the world
  g.shadowBlur = 0;
  g.strokeStyle = 'rgba(63,240,165,0.28)';
  g.lineWidth = Math.max(2, W / 1400);
  g.strokeRect(g.lineWidth / 2, g.lineWidth / 2, W - g.lineWidth, H - g.lineWidth);

  const tex = new THREE.CanvasTexture(cv);
  if ('encoding' in tex && THREE.sRGBEncoding) tex.encoding = THREE.sRGBEncoding;
  tex.anisotropy = renderer.capabilities.getMaxAnisotropy ? renderer.capabilities.getMaxAnisotropy() : 1;
  tex.minFilter = THREE.LinearMipmapLinearFilter;
  tex.magFilter = THREE.LinearFilter;
  tex.wrapS = tex.wrapT = THREE.ClampToEdgeWrapping;
  tex.needsUpdate = true;
  return tex;
}

function setWorldCoastlines(world) {
  const pts = [];
  for (const line of world.lines) {
    for (let i = 0; i + 3 < line.length; i += 2) {
      pts.push(new THREE.Vector3(line[i + 1], line[i], 0.006),
               new THREE.Vector3(line[i + 3], line[i + 2], 0.006));
    }
  }
  geo.setFromPoints(pts);
  geo.getAttribute('position').needsUpdate = true;
  geo.computeBoundingSphere();
  const old = mapPlane.material.map;
  mapPlane.material.map = buildMapTexture(world);
  mapPlane.material.needsUpdate = true;
  if (old) old.dispose();
  worldBuilt = true;
}

/* ------------------------------------------------------------------ clustering */
/* Three zoom levels of the same idea: neighbouring stations merge into one light,
   and zooming in splits them apart until each station stands alone. */
const CLUSTER_LEVELS = [
  { step: 1.15, maxZoom: 3.2 },        // planet: ~1.1k lights
  { step: 0.42, maxZoom: 10 },         // country
  { step: 0.13, maxZoom: 26 },         // city
  { step: 0.045, maxZoom: Infinity }   // neighbourhood: individual stations
];
let levelIndex = 0;

function clusterAt(stations, step) {
  const grid = new Map(), clusters = [];
  const key = (a, b) => a * 100000 + b;
  for (let i = 0; i < stations.length; i++) {
    const s = stations[i];
    const gl = Math.floor(s.lat / step), gn = Math.floor(s.lon / step);
    let best = null, bestD = Infinity;
    for (let dl = -1; dl <= 1; dl++) {
      for (let dn = -1; dn <= 1; dn++) {
        const bucket = grid.get(key(gl + dl, gn + dn));
        if (!bucket) continue;
        for (const c of bucket) {
          const d = Math.hypot(c.lat - s.lat, (c.lon - s.lon) * Math.cos(s.lat * RAD));
          if (d < bestD) { bestD = d; best = c; }
        }
      }
    }
    if (best && bestD <= step * 0.92) {
      best.count++; best.votes += s.votes;
      if (s.cc) best.ccs.add(s.cc);
    } else {
      const c = { lat: s.lat, lon: s.lon, count: 1, votes: s.votes, top: i,
                  ccs: new Set(s.cc ? [s.cc] : []) };
      clusters.push(c);
      const k = key(gl, gn);
      if (!grid.has(k)) grid.set(k, []);
      grid.get(k).push(c);
    }
  }
  return clusters;
}

function buildClusters() {
  state.clusterLevels = CLUSTER_LEVELS.map((l) => clusterAt(state.stations, l.step));
  state.clusters = state.clusterLevels[0];
  levelIndex = 0;

  const byCc = new Map();
  for (const s of state.stations) {
    if (!s.cc) continue;
    if (!byCc.has(s.cc)) byCc.set(s.cc, { cc: s.cc, name: shortCountry(s.country) || s.cc, count: 0, lat: 0, lon: 0, w: 0 });
    const c = byCc.get(s.cc);
    c.count++; c.w += Math.max(1, s.votes);
  }
  state.countries = [...byCc.values()].sort((a, b) => b.count - a.count);
  // vote-weighted centroid, averaged in 3D so the ±180 seam does not break it
  for (const c of state.countries) {
    let x = 0, y = 0, z = 0;
    for (const s of state.stations) {
      if (s.cc !== c.cc) continue;
      const w = Math.max(1, s.votes);
      const cl = Math.cos(s.lat * RAD);
      x += w * cl * Math.sin(s.lon * RAD);
      y += w * Math.sin(s.lat * RAD);
      z += w * cl * Math.cos(s.lon * RAD);
    }
    const ll = vec3ToLatLon(new THREE.Vector3(x, y, z));
    c.lat = ll.lat; c.lon = ll.lon;
  }
}

/* match the level to the zoom, with hysteresis so the lights do not flicker */
function pickLevel(zoom) {
  if (zoom > CLUSTER_LEVELS[levelIndex].maxZoom * 1.15 && levelIndex < CLUSTER_LEVELS.length - 1) {
    levelIndex++;
  } else if (levelIndex > 0 && zoom < CLUSTER_LEVELS[levelIndex - 1].maxZoom * 0.82) {
    levelIndex--;
  }
  state.clusters = state.clusterLevels[levelIndex];
}

let lastBuildKey = '';
function rebuildPoints(force) {
  const v = state.view;
  pickLevel(v.zoom);
  const focus = state.countryFilter ? state.countryFilter.cc : null;
  const key = `${levelIndex}|${v.lat.toFixed(1)}|${v.lon.toFixed(1)}|${v.zoom.toFixed(2)}|${focus}|${state.searchHits.length}|${state.faves.length}|${state.playing ? state.playing.url : ''}`;
  if (!force && key === lastBuildKey) return;
  lastBuildKey = key;

  const P = attr.position.array, C = attr.color.array, S = attr.size.array,
    X = attr.sel.array, O = attr.sol.array;
  let n = 0;
  const selKey = state.selected ? state.selected.key : null;
  const favSet = new Set(state.faves.map((f) => f.url));
  const order = [];   // drawn index -> cluster, so a pick can be resolved back
  const latMin = v.lat - mapHalfH - 2, latMax = v.lat + mapHalfH + 2;
  const lonMin = v.lon - mapHalfW - 2, lonMax = v.lon + mapHalfW + 2;

  const push = (lat, lon, z, r, g, b, size, sel, sol) => {
    if (n >= MAX_POINTS) return -1;
    P[n * 3] = lon; P[n * 3 + 1] = lat; P[n * 3 + 2] = z;
    C[n * 3] = r; C[n * 3 + 1] = g; C[n * 3 + 2] = b;
    S[n] = size; X[n] = sel; O[n] = sol;
    return n++;
  };

  for (const c of state.clusters) {
    if (c.lat < latMin || c.lat > latMax || c.lon < lonMin || c.lon > lonMax) continue;
    if (focus && !c.ccs.has(focus)) continue;
    const s = state.stations[c.top];
    const boost = Math.min(1, Math.log10((s.votes || 0) + 1) / 4.6);
    let size = 0.0082 + boost * 0.0058 + Math.min(1, Math.log2(c.count) / 8) * 0.0055;
    let r = 0.24, g = 0.95, b = 0.68;                             // mint: a station
    let sel = 0, sol = 0;
    if (favSet.has(s.url)) { r = 1; g = 0.45; b = 0.72; }         // saved: pink
    if (selKey && s.key === selKey) { sel = 1; size *= 1.5; r = 1; g = 1; b = 1; }
    if (state.playing && s.url === state.playing.url) { sel = Math.max(sel, 0.85); size *= 1.3; r = 1; g = 1; b = 1; }
    if (push(c.lat, c.lon, 0.02, r, g, b, size, sel, sol) >= 0) order.push(c);
  }
  clusterOrder = order;
  searchBase = order.length;

  // search / live results sit above the field in gold
  searchHitsDrawn = 0;
  for (const st of state.searchHits) {
    if (st.lat < latMin || st.lat > latMax || st.lon < lonMin || st.lon > lonMax) continue;
    if (push(st.lat, st.lon, 0.03, 1, 0.84, 0.4, 0.016, 0.4, 0.85) >= 0) searchHitsDrawn++;
  }

  attr.position.needsUpdate = true;
  attr.color.needsUpdate = true;
  attr.size.needsUpdate = true;
  attr.sel.needsUpdate = true;
  attr.sol.needsUpdate = true;
  stationPoints.geometry.setDrawRange(0, n);
  pointCount = n;
}

/* ------------------------------------------------------------------ picking */
let clusterOrder = [];      // drawn index -> cluster object
let searchBase = 0;         // first drawn index that belongs to state.searchHits
let searchHitsDrawn = 0;
const scrX = new Float32Array(MAX_POINTS);
const scrY = new Float32Array(MAX_POINTS);
let lastPick = 0;
const mouse = { x: -999, y: -999, inside: false };

function projectPoints() {
  if (!pointCount) return;
  const P = attr.position.array;
  const e = camera.projectionMatrix.elements, m = camera.matrixWorldInverse.elements;
  const w = window.innerWidth, h = window.innerHeight;
  for (let i = 0; i < pointCount; i++) {
    const x = P[i * 3], y = P[i * 3 + 1], z = P[i * 3 + 2];
    const vx = m[0] * x + m[4] * y + m[8] * z + m[12];
    const vy = m[1] * x + m[5] * y + m[9] * z + m[13];
    const vz = m[2] * x + m[6] * y + m[10] * z + m[14];
    const cw = e[3] * vx + e[7] * vy + e[11] * vz + e[15];
    const cx = e[0] * vx + e[4] * vy + e[8] * vz + e[12];
    const cy = e[1] * vx + e[5] * vy + e[9] * vz + e[13];
    if (cw <= 0.0001) { scrX[i] = -9999; continue; }
    scrX[i] = (cx / cw * 0.5 + 0.5) * w;
    scrY[i] = (-cy / cw * 0.5 + 0.5) * h;
  }
}

function pointHitTest(px, py) {
  if (!pointCount || px < 0 || py < 0 || px > window.innerWidth || py > window.innerHeight) return null;
  let bestI = -1, bestD = 27 * 27;
  for (let i = 0; i < pointCount; i++) {
    const dx = scrX[i] - px;
    if (dx > 27 || dx < -27) continue;
    const dy = scrY[i] - py;
    const d = dx * dx + dy * dy;
    if (d < bestD) { bestD = d; bestI = i; }
  }
  if (bestI < 0) return null;
  if (bestI < searchBase) return clusterOrder[bestI] ? { kind: 'cluster', cluster: clusterOrder[bestI] } : null;
  const st = state.searchHits[bestI - searchBase];
  return st ? { kind: 'station', station: st } : null;
}

/* ------------------------------------------------------------------ satellite */
/* Live satellite imagery as a tile layer under everything else: NASA's daily true-colour pass
   (VIIRS on NOAA-20), published as equirectangular tiles — they drop straight onto this flat
   map with no reprojection, and a fresh day of imagery arrives every day. NASA serves them
   with CORS headers, so this works with or without the server behind it.

   The grid is unusual: tiles are 512 px square and the degrees they cover halve each level
   (L0 288°, L1 144°, L2 72° … L8 1.125°), so the world is only 2.5 tiles wide at L1 and
   exactly 320 tiles across at L8. Edge tiles run past the poles and the antimeridian, so
   every tile is clipped to the map and its texture coordinates are remapped to match. */
const SAT = {
  on: false, group: null, tiles: new Map(), retire: [], pending: 0, requests: 0, queue: [],
  loaded: 0, failed: 0, date: '', probed: false, reloading: false, lastPlan: 0, lastKey: '',
  live: { layer: 'VIIRS_NOAA20_CorrectedReflectance_TrueColor', matrix: '250m', maxLevel: 8,
          attribution: 'NASA GIBS · VIIRS true colour' }
};
const SAT_LIVE_MIN_DEG = 2.6;      // below this the daily pass is stretched past its detail
const SAT_TILE_PX = 380;           // aim for tiles about this big on screen
const SAT_MAX_TILES = 90;
const SAT_MAX_LEVEL = 8;

const satISODate = (back = 1) => new Date(Date.now() - back * 864e5).toISOString().slice(0, 10);

/* one level of NASA's pyramid: 512 px tiles, square in degrees */
function satGrid(level) {
  const res = 0.5625 / 2 ** level;                  // degrees per source pixel
  const span = 512 * res;                           // a tile's width and height in degrees
  return { res, span, cols: Math.ceil(360 / span), rows: Math.ceil(180 / span) };
}

function satLevel() {
  const want = SAT_TILE_PX * degPerPixel();
  for (let z = 0; z <= SAT_MAX_LEVEL; z++) {
    if (satGrid(z).span <= want * 1.35) return z;
  }
  return SAT_MAX_LEVEL;
}

function buildSatellite() {
  SAT.group = new THREE.Group();
  SAT.group.position.z = -0.08;          // above the ocean backdrop, under the map plane
  SAT.group.visible = false;
  scene.add(SAT.group);
  SAT.loader = new THREE.TextureLoader();
  SAT.loader.setCrossOrigin('anonymous');
}

function satTileUrl(z, x, y, date) {
  return HAS_BACKEND
    ? `api/tile?src=gibs&z=${z}&x=${x}&y=${y}&d=${date}`
    : `https://gibs.earthdata.nasa.gov/wmts/epsg4326/best/${SAT.live.layer}/default/${date}/${SAT.live.matrix}/${z}/${y}/${x}.jpg`;
}

/* the tiles covering the screen, clipped to the world */
function satTilesForView() {
  const v = state.view;
  const z = satLevel();
  const g = satGrid(z);
  const padW = mapHalfW * 1.15, padH = mapHalfH * 1.15;
  const lon0 = clamp(v.lon - padW, -180, 180), lon1 = clamp(v.lon + padW, -180, 180);
  const lat0 = clamp(v.lat - padH, -89.5, 89.5), lat1 = clamp(v.lat + padH, -89.5, 89.5);
  const c0 = clamp(Math.floor((lon0 + 180) / g.span), 0, g.cols - 1);
  const c1 = clamp(Math.floor((lon1 + 180) / g.span), 0, g.cols - 1);
  const r0 = clamp(Math.floor((90 - lat1) / g.span), 0, g.rows - 1);
  const r1 = clamp(Math.floor((90 - lat0) / g.span), 0, g.rows - 1);
  const out = [];
  for (let row = r0; row <= r1; row++) {
    for (let col = c0; col <= c1; col++) {
      const tLon0 = -180 + col * g.span, tLat1 = 90 - row * g.span;
      out.push({
        key: `${z}:${col}:${row}`, z, x: col, y: row, span: g.span, tLon0, tLat1,
        lon0: Math.max(tLon0, -180), lon1: Math.min(tLon0 + g.span, 180),
        lat0: Math.max(tLat1 - g.span, -90), lat1: Math.min(tLat1, 90)
      });
      if (out.length >= SAT_MAX_TILES) return { z, tiles: out };
    }
  }
  return { z, tiles: out };
}

function satMakeMesh(t) {
  const w = t.lon1 - t.lon0, h = t.lat1 - t.lat0;
  const geo = new THREE.PlaneGeometry(w, h);
  const uv = geo.attributes.uv, pos = geo.attributes.position;
  const u0 = (t.lon0 - t.tLon0) / t.span, u1 = (t.lon1 - t.tLon0) / t.span;
  const vN = 1 - (t.tLat1 - t.lat1) / t.span, vS = 1 - (t.tLat1 - t.lat0) / t.span;
  for (let i = 0; i < uv.count; i++) {
    const x = pos.getX(i), y = pos.getY(i);
    uv.setXY(i, u0 + (x + w / 2) / w * (u1 - u0), vS + (y + h / 2) / h * (vN - vS));
  }
  uv.needsUpdate = true;
  const mesh = new THREE.Mesh(geo, new THREE.MeshBasicMaterial({
    color: 0x39424a, depthWrite: false
  }));
  mesh.position.set((t.lon0 + t.lon1) / 2, (t.lat0 + t.lat1) / 2, 0);
  mesh.userData = { key: t.key, loaded: false };
  return mesh;
}

/* a small queue keeps us from firing sixty requests at once */
function satPump() {
  while (SAT.pending < 6 && SAT.queue.length) {
    const job = SAT.queue.shift();
    if (!job.mesh.parent) continue;
    SAT.pending++; SAT.requests++;
    SAT.loader.load(job.url, (tex) => {
      tex.minFilter = THREE.LinearFilter; tex.magFilter = THREE.LinearFilter;
      tex.generateMipmaps = false;
      if (THREE.sRGBEncoding) tex.encoding = THREE.sRGBEncoding;
      job.mesh.material.map = tex;
      job.mesh.material.color.set(0xffffff);
      job.mesh.material.needsUpdate = true;
      job.mesh.userData.loaded = true;
      SAT.loaded++; SAT.pending--;
      satDropRetired();
      satPump();
    }, undefined, () => {
      SAT.pending--; SAT.failed++;
      // one dead tile is normal (a gap in the daily pass). Only if nothing at all arrives
      // does it mean the date is unpublished — then step a day back, once.
      if (!SAT.reloading && SAT.failed >= 3 && !SAT.loaded) {
        SAT.reloading = true;
        SAT.tiles.forEach((m) => { SAT.group.remove(m); m.material.dispose(); });
        SAT.tiles.clear(); SAT.queue.length = 0;
        SAT.date = satISODate(2); SAT.lastKey = ''; SAT.failed = 0;
        setTimeout(() => { SAT.reloading = false; }, 800);
      }
      satPump();
    });
  }
}

/* the previous level stays on screen until the new one is mostly there, so no grey flash */
function satDropRetired() {
  if (!SAT.retire.length) return;
  const total = SAT.tiles.size;
  const ready = [...SAT.tiles.values()].filter((m) => m.userData.loaded).length;
  if (SAT.pending === 0 || total === 0 || ready >= Math.ceil(total * 0.75)) {
    SAT.retire.forEach((m) => { SAT.group.remove(m); m.material.dispose(); });
    SAT.retire.length = 0;
  }
}

function updateSatellite(now) {
  if (!SAT.group) return;
  SAT.group.visible = SAT.on;
  if (!SAT.on) return;
  if (now && SAT.lastPlan && now - SAT.lastPlan < 220) return;
  SAT.lastPlan = now || 0;

  const plan = satTilesForView();
  const key = `${plan.z}:${plan.tiles.map((t) => t.key).join('|')}`;
  if (key === SAT.lastKey) { satPump(); satDropRetired(); return; }
  SAT.lastKey = key;
  SAT.failed = 0;
  satCredit();

  const wanted = new Set(plan.tiles.map((t) => t.key));
  SAT.tiles.forEach((mesh, k) => {
    if (!wanted.has(k)) { SAT.tiles.delete(k); SAT.retire.push(mesh); }
  });
  for (const t of plan.tiles) {
    if (SAT.tiles.has(t.key)) continue;
    const mesh = satMakeMesh(t);
    SAT.group.add(mesh);
    SAT.tiles.set(t.key, mesh);
    SAT.queue.push({ mesh, url: satTileUrl(t.z, t.x, t.y, SAT.date) });
  }
  satPump();
  satDropRetired();
}

function satCredit() {
  const el = dom.satCredit;
  if (!el) return;
  if (!SAT.on) { el.hidden = true; return; }
  el.hidden = false;
  el.textContent = `Live satellite \u00b7 ${SAT.live.attribution} \u00b7 ${SAT.date}`;
}

function toggleSatellite(force) {
  SAT.on = typeof force === 'boolean' ? force : !SAT.on;
  if (dom.btnSat) dom.btnSat.classList.toggle('active', SAT.on);
  if (stationPoints && stationPoints.material) {
    stationPoints.material.blending = SAT.on ? THREE.NormalBlending : THREE.AdditiveBlending;
    if (stationPoints.material.uniforms && stationPoints.material.uniforms.uSat) {
      stationPoints.material.uniforms.uSat.value = SAT.on ? 1 : 0;
    }
    stationPoints.material.needsUpdate = true;
  }
  if (SAT.on) {
    if (!SAT.date) SAT.date = satISODate(1);
    if (!SAT.probed && HAS_BACKEND) {          // let the server tell us which day has imagery
      SAT.probed = true;
      fetch('api/satellite').then((r) => r.json()).then((d) => {
        if (d && d.live && d.live.date) {
          SAT.date = d.live.date;
          if (!SAT.requests) SAT.lastKey = '';
        }
      }).catch(() => {});
    }
    SAT.lastKey = '';
    toast('Satellite imagery on \u2014 NASA\u2019s daily true-colour pass. Press S for the plain map.');
  } else {
    SAT.tiles.forEach((m) => { SAT.group.remove(m); m.material.dispose(); });
    SAT.retire.forEach((m) => { SAT.group.remove(m); m.material.dispose(); });
    SAT.tiles.clear(); SAT.retire.length = 0; SAT.queue.length = 0; SAT.lastKey = '';
    toast('Back to the dark map.');
  }
  updateMapStyle(state.view.zoom - 1, true);
  satCredit();
}

/* ------------------------------------------------------------------ animation loop */
let lastT = performance.now();
function tick(now) {
  const dt = Math.min(0.05, (now - lastT) / 1000) || 0.016;
  lastT = now;
  const v = state.view;

  // ease towards the target centre and zoom (drag / flyTo only move the targets)
  if (!state.dragging) {
    const k = 1 - Math.pow(0.0016, dt);
    v.lat = lerp(v.lat, v.tLat, k);
    v.lon = lerp(v.lon, v.tLon, k);
    // zoom eases in log space, so a jump from 40 back to 1 takes about as long as
    // a nudge from 2 to 1 (linear easing makes big jumps feel like they stall)
    const lz = Math.log(v.zoom), lt = Math.log(v.tZoom);
    v.zoom = Math.exp(lz + (lt - lz) * (1 - Math.pow(0.004, dt)));
  }
  clampView();
  updateCameraFrustum();
  updateMapStyle(v.zoom);
  updateSatellite(now);
  rebuildPoints(false);

  // pulsing rings around the tuned station, at a constant screen size
  if (state.selected) {
    const dpp = degPerPixel();
    const p = v3(state.selected.lat, state.selected.lon, 0.05);
    ringA.position.copy(p); ringB.position.copy(p);
    const pulse = (now % 2600) / 2600;
    ringA.scale.setScalar(dpp * 16 * (1 + pulse * 0.8));
    ringA.material.opacity = 0.75 * (1 - pulse);
    const p2 = (pulse + 0.5) % 1;
    ringB.scale.setScalar(dpp * 16 * (1 + p2 * 1.2));
    ringB.material.opacity = 0.4 * (1 - p2);
    ringA.visible = ringB.visible = true;
  } else {
    ringA.visible = ringB.visible = false;
  }

  renderer.render(scene, camera);

  // hit testing is throttled: it is the only pixel-ish work in the loop
  if (now - lastPick > 90) {
    lastPick = now;
    projectPoints();
    if (state.dragging || !mouse.inside) setHover(null);
    else setHover(pointHitTest(mouse.x, mouse.y));
  }
  requestAnimationFrame(tick);
}

/* ------------------------------------------------------------------ hover */
function setHover(hit) {
  const canvas = renderer.domElement;
  if (!hit) {
    if (state.hovered) { state.hovered = null; dom.tooltip.hidden = true; canvas.classList.remove('pointing'); }
    return;
  }
  const same = state.hovered && state.hovered.kind === hit.kind &&
    state.hovered.cluster === hit.cluster && state.hovered.station === hit.station;
  state.hovered = hit;
  canvas.classList.add('pointing');
  if (same && !dom.tooltip.hidden) return;

  let name, meta, x, y;
  if (hit.kind === 'cluster') {
    const c = hit.cluster, s = state.stations[c.top];
    name = c.count > 1 ? `${esc(s.name)}` : esc(s.name);
    const cc = s.country ? `${flagEmoji(s.cc)} ${esc(shortCountry(s.country))}` : '';
    meta = (c.count > 1 ? `${c.count} stations here · ` : '') + cc;
    const p = v3(c.lat, c.lon, 0.05).project(camera);
    x = (p.x * 0.5 + 0.5) * window.innerWidth;
    y = (-p.y * 0.5 + 0.5) * window.innerHeight;
  } else {
    const s = hit.station;
    name = esc(s.name);
    meta = `${flagEmoji(s.cc)} ${esc(shortCountry(s.country))}${s.codec ? ' · ' + esc(s.codec) + (s.bitrate ? ' ' + s.bitrate + 'k' : '') : ''}`;
    const p = v3(s.lat, s.lon, 0.05).project(camera);
    x = (p.x * 0.5 + 0.5) * window.innerWidth;
    y = (-p.y * 0.5 + 0.5) * window.innerHeight;
  }
  dom.tipName.textContent = ''; dom.tipName.innerHTML = name;
  dom.tipMeta.textContent = meta;
  dom.tooltip.style.left = `${clamp(x, 90, window.innerWidth - 90)}px`;
  dom.tooltip.style.top = `${clamp(y, 60, window.innerHeight - 60)}px`;
  dom.tooltip.hidden = false;
}

/* ------------------------------------------------------------------ interaction */
function latLonAtScreen(px, py) {
  const v = state.view;
  const ndcx = (px / window.innerWidth) * 2 - 1;
  const ndcy = -(py / window.innerHeight) * 2 + 1;
  return {
    lat: clamp(v.lat + ndcy * mapHalfH, -90, 90),
    lon: clamp(v.lon + ndcx * mapHalfW, -180, 180)
  };
}

function bindMapInput() {
  const canvas = renderer.domElement;
  const pointers = new Map();
  let moved = 0, vx = 0, vy = 0, lastX = 0, lastY = 0, pinchDist = 0;

  // zoom, keeping whatever sits under the cursor exactly where it is
  const zoomAt = (px, py, factor) => {
    const v = state.view;
    const aspect = window.innerWidth / Math.max(1, window.innerHeight);
    const ndcx = (px / window.innerWidth) * 2 - 1;
    const ndcy = -(py / window.innerHeight) * 2 + 1;
    const anchorLon = v.lon + ndcx * mapHalfW;
    const anchorLat = v.lat + ndcy * mapHalfH;
    const z = clamp(v.tZoom * factor, MIN_ZOOM, MAX_ZOOM);
    v.zoom = v.tZoom = z;
    const halfH = degViewHeight(z) / 2, halfW = halfH * aspect;
    v.lon = v.tLon = anchorLon - ndcx * halfW;
    v.lat = v.tLat = anchorLat - ndcy * halfH;
    clampView();
    updateCameraFrustum();
    rebuildPoints(false);
  };

  canvas.addEventListener('pointerdown', (e) => {
    canvas.setPointerCapture(e.pointerId);
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
    if (pointers.size === 1) {
      state.dragging = true; moved = 0; vx = vy = 0;
      lastX = e.clientX; lastY = e.clientY;
      canvas.classList.add('dragging');
    } else if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      pinchDist = Math.hypot(a.x - b.x, a.y - b.y);
    }
  });

  canvas.addEventListener('pointermove', (e) => {
    mouse.x = e.clientX; mouse.y = e.clientY; mouse.inside = true;
    if (!pointers.has(e.pointerId)) return;
    pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

    if (pointers.size === 2) {
      const [a, b] = [...pointers.values()];
      const d = Math.hypot(a.x - b.x, a.y - b.y);
      if (pinchDist && d > 0) zoomAt((a.x + b.x) / 2, (a.y + b.y) / 2, d / pinchDist);
      pinchDist = d;
      return;
    }
    if (!state.dragging) return;
    const dx = e.clientX - lastX, dy = e.clientY - lastY;
    lastX = e.clientX; lastY = e.clientY;
    moved += Math.abs(dx) + Math.abs(dy);
    const dpp = degPerPixel();
    state.view.tLon -= dx * dpp; state.view.lon -= dx * dpp;
    state.view.tLat += dy * dpp; state.view.lat += dy * dpp;
    vx = -dx; vy = dy;
    clampView();
    dom.tooltip.hidden = true;
  });

  const endPointer = (e) => {
    pointers.delete(e.pointerId);
    if (pointers.size < 2) pinchDist = 0;
    if (pointers.size === 0) {
      canvas.classList.remove('dragging');
      if (state.dragging && moved < 7 && e.type === 'pointerup') clickAt(e.clientX, e.clientY);
      state.dragging = false;
      const decay = () => {
        if (state.dragging || (Math.abs(vx) < 0.4 && Math.abs(vy) < 0.4)) return;
        const dpp = degPerPixel();
        state.view.tLon += vx * dpp; state.view.lon += vx * dpp;
        state.view.tLat += vy * dpp; state.view.lat += vy * dpp;
        vx *= 0.9; vy *= 0.9;
        clampView();
        requestAnimationFrame(decay);
      };
      requestAnimationFrame(decay);
    }
  };
  canvas.addEventListener('pointerup', endPointer);
  canvas.addEventListener('pointercancel', endPointer);
  canvas.addEventListener('pointerleave', (e) => {
    mouse.inside = false; dom.tooltip.hidden = true;
    endPointer(e);
  });

  canvas.addEventListener('wheel', (e) => {
    e.preventDefault();
    zoomAt(e.clientX, e.clientY, Math.exp(-e.deltaY * 0.0018));
  }, { passive: false });

  canvas.addEventListener('dblclick', (e) => {
    zoomAt(e.clientX, e.clientY, 1.9);
  });
}

function clickAt(x, y) {
  const hit = pointHitTest(x, y);
  const v = state.view;
  const far = (c) => Math.abs(c.lat - v.tLat) > degViewHeight(v.zoom) * 0.3 ||
                     Math.abs(c.lon - v.tLon) > degViewHeight(v.zoom) * 0.5;

  if (hit && hit.kind === 'cluster') {
    const c = hit.cluster, s = state.stations[c.top];
    tuneStation(s);
    if (far(c)) flyTo(c.lat, c.lon, clamp(v.tZoom * 1.6, 2, MAX_ZOOM));
    openPanel('nearby', { lat: c.lat, lon: c.lon, label: shortCountry(s.country) });
    return;
  }
  if (hit && hit.kind === 'station') {
    const s = hit.station;
    tuneStation(s);
    if (far(s)) flyTo(s.lat, s.lon, clamp(v.tZoom * 1.4, 2, MAX_ZOOM));
    openPanel('nearby', { lat: s.lat, lon: s.lon, label: shortCountry(s.country) });
    return;
  }

  // empty map: what is broadcasting here?
  const ll = latLonAtScreen(x, y);
  flyTo(ll.lat, ll.lon, clamp(v.tZoom * 1.3, 1.2, MAX_ZOOM));
  openPanel('nearby', { lat: ll.lat, lon: ll.lon, label: '' });
}

/* ------------------------------------------------------------------ fly + panel */
function flyTo(lat, lon, zoom) {
  const v = state.view;
  v.tLat = clamp(lat, -89, 89);
  v.tLon = clamp(lon, -179.5, 179.5);
  if (zoom != null) v.tZoom = clamp(zoom, MIN_ZOOM, MAX_ZOOM);
  clampView();
}

/* back to the whole world */
function resetFit() {
  flyTo(12, 8, 1);
}
function zoomTo(lat, lon) {
  const v = state.view;
  // a zoom that spreads this cluster out a little
  flyTo(lat, lon, clamp(v.tZoom * 1.9, 1.6, MAX_ZOOM));
}

function rowDistance(row, lat, lon) { return haversine(lat, lon, row.lat, row.lon); }

function openPanel(mode, opts = {}) {
  state.panelMode = mode;
  dom.panel.hidden = false;
  dom.card.classList.add('has-panel');
  dom.panelOnline.hidden = true;
  dom.panelOnline.onclick = null;
  if (dom.panelExtra) { dom.panelExtra.hidden = true; dom.panelExtra.onclick = null; }
  const places = [];

  if (mode === 'nearby') {
    const lat = opts.lat, lon = opts.lon;
    const place = opts.label || '';
    dom.panelEyebrow.textContent = 'Within reach';
    dom.panelTitle.textContent = place || 'Stations around here';
    const rows = state.stations
      .filter((s) => !state.deadUrls[s.url])
      .map((s) => ({ s, km: rowDistance(s, lat, lon) }))
      .filter((x) => x.km <= 900)
      .sort((a, b) => a.km - b.km)
      .slice(0, 70);
    dom.panelSub.textContent = rows.length
      ? `${rows.length} stations · nearest first`
      : 'No station in our atlas within 900 km';
    for (const r of rows) places.push({ s: r.s, kind: 'nearby', km: r.km, focus: { lat, lon } });
    if (rows.length < 6 && HAS_BACKEND) {
      dom.panelOnline.hidden = false;
      dom.panelOnline.textContent = 'Ask Radio Browser for live stations near here';
      dom.panelOnline.onclick = () => fetchLiveNearby(lat, lon, place);
    }
    if (!rows.length) { fetchLiveNearby(lat, lon, place); }
  }

  if (mode === 'country') {
    const cc = opts.cc;
    const nice = shortCountry(opts.name);
    state.countryFilter = { cc, name: nice };
    dom.panelEyebrow.textContent = 'Country';
    dom.panelTitle.textContent = `${flagEmoji(cc)} ${nice}`.trim();
    const rows = state.stations.filter((s) => s.cc === cc).sort((a, b) => b.votes - a.votes);
    dom.panelSub.textContent = `${opts.count} stations in the atlas · most popular first`;
    for (const s of rows.slice(0, 80)) places.push({ s, kind: 'country' });
    if (rows.length < 25 && HAS_BACKEND) {
      dom.panelOnline.hidden = false;
      dom.panelOnline.textContent = 'Look up more stations in this country (live)';
      dom.panelOnline.onclick = () => fetchLiveCountry(cc, opts.name);
    }
    zoomTo(opts.lat, opts.lon);
  }

  if (mode === 'genre') {
    dom.panelEyebrow.textContent = 'Genre';
    dom.panelTitle.textContent = opts.name;
    const rows = state.stations.filter((s) => s.tags.toLowerCase().includes(String(opts.name).toLowerCase()))
      .sort((a, b) => b.votes - a.votes);
    dom.panelSub.textContent = `${rows.length} stations tagged “${opts.name}”`;
    for (const s of rows.slice(0, 80)) places.push({ s, kind: 'genre' });
    if (rows.length < 12 && HAS_BACKEND) {
      dom.panelOnline.hidden = false;
      dom.panelOnline.textContent = 'Search this genre live';
      dom.panelOnline.onclick = () => runSearch(String(opts.name), true);
    }
  }

  if (mode === 'search') {
    dom.panelEyebrow.textContent = 'Search';
    dom.panelTitle.textContent = `“${opts.term}”`;
    const rows = opts.rows || state.searchHits;
    dom.panelSub.textContent = `${rows.length} matching stations from the live directory`;
    for (const s of rows) places.push({ s, kind: 'search' });
  }

  if (mode === 'faves') {
    state.countryFilter = null;
    dom.panelEyebrow.textContent = 'Saved';
    dom.panelTitle.textContent = 'Your stations';
    dom.panelSub.textContent = state.faves.length
      ? `${state.faves.length} saved on this device`
      : 'Tap the heart on a station to keep it here';
    for (const s of state.faves) places.push({ s, kind: 'fave' });
    if (state.faves.length) {
      dom.panelOnline.hidden = false;
      dom.panelOnline.textContent = 'Cycle through these stations';
      dom.panelOnline.onclick = () => {
        cycleToggle(true, state.faves.map((f) => Object.assign({}, f)));
        toast(`Cycling your ${state.faves.length} saved stations.`, 3600);
      };
      if (dom.panelExtra) {
        dom.panelExtra.hidden = false;
        dom.panelExtra.textContent = 'Download the list (.m3u)';
        dom.panelExtra.onclick = exportFaves;
      }
    }
  }

  renderPanelList(places);
}

function renderPanelList(places) {
  dom.list.innerHTML = '';
  if (!places.length) {
    dom.list.innerHTML = '<li class="empty">Nothing here yet.</li>';
    return;
  }
  const frag = document.createDocumentFragment();
  for (const p of places) {
    const s = p.s;
    const li = document.createElement('li');
    const btn = document.createElement('button');
    btn.className = 'row' + (state.playing && state.playing.url === s.url ? ' playing' : '');
    if (state.deadUrls[s.url]) btn.classList.add('dead');
    const metaBits = [];
    if (p.km != null) metaBits.push(fmtKm(p.km));
    if (s.country) metaBits.push(`${flagEmoji(s.cc)} ${esc(shortCountry(s.country))}`.trim());
    if (s.codec) metaBits.push(esc(s.codec) + (s.bitrate ? ` ${s.bitrate}k` : ''));
    if (!metaBits.length && s.tags) metaBits.push(esc(s.tags.split(',')[0]));
    btn.innerHTML = `<span class="dot"></span><span class="row-main">
        <span class="row-name">${esc(s.name)}</span>
        <span class="row-meta">${metaBits.join(' · ')}</span></span>
        <span class="go"><svg viewBox="0 0 24 24"><path d="M8 5.2v13.6L19 12 8 5.2Z" fill="currentColor"/></svg></span>`;
    btn.dataset.url = s.url || '';
    btn.addEventListener('click', () => {
      if (s.url && state.playing && state.playing.url === s.url) { togglePlay(); return; }
      if (p.focus) flyTo(s.lat, s.lon, Math.max(state.view.tZoom, 3.2));
      tuneStation(s, places.map((q) => q.s));
      for (const el of dom.list.querySelectorAll('.row.playing')) el.classList.remove('playing');
      btn.classList.add('playing');
    });
    li.appendChild(btn);
    frag.appendChild(li);
  }
  dom.list.appendChild(frag);
}

async function fetchLiveNearby(lat, lon, label) {
  if (!HAS_BACKEND) {
    dom.panelNote.textContent = 'In the single-file build this uses the offline atlas only.';
    return;
  }
  dom.panelOnline.disabled = true;
  dom.panelOnline.textContent = 'Contacting Radio Browser…';
  dom.panelNote.textContent = '';
  try {
    const r = await fetch(`api/nearby?lat=${lat}&lon=${lon}&km=900&limit=60`);
    const data = await r.json();
    if (data.error) throw new Error(data.error);
    const rows = data.stations.filter((s) => s.lat && s.lon);
    state.searchHits = rows;
    lastBuildKey = '';
    if (!rows.length) { dom.panelNote.textContent = 'Still nothing — try clicking closer to a big city.'; return; }
    openPanel('search', { term: label || 'nearby (live)', rows });
    dom.panelEyebrow.textContent = 'Live · within 900 km';
    dom.panelTitle.textContent = label || 'Stations around here';
  } catch (e) {
    dom.panelNote.textContent = 'Live lookup failed — the directory may be unreachable.';
  } finally {
    dom.panelOnline.disabled = false;
  }
}

async function fetchLiveCountry(cc, name) {
  if (!HAS_BACKEND) {
    dom.panelNote.textContent = 'In the single-file build this uses the offline atlas only.';
    return;
  }
  dom.panelOnline.disabled = true;
  dom.panelOnline.textContent = 'Contacting Radio Browser…';
  try {
    const r = await fetch(`api/search?q=${encodeURIComponent(name)}&limit=100`);
    const data = await r.json();
    if (data.error) throw new Error(data.error);
    const rows = data.stations.filter((s) => s.cc === cc || !cc);
    if (!rows.length) throw new Error('none');
    state.searchHits = rows;
    lastBuildKey = '';
    openPanel('search', { term: name + ' (live)', rows });
  } catch (e) {
    dom.panelNote.textContent = 'Live lookup failed.';
  } finally {
    dom.panelOnline.disabled = false;
  }
}

/* ------------------------------------------------------------------ cycling */
/* A channel-surf: the app walks the stations around you, tuning one every twenty seconds
   and taking the map along, wrapping on into the next town when it runs out of stations.
   C starts and stops it, N skips ahead, picking a station yourself stops it. */
const CYCLE = { on: false, list: [], fixed: null, idx: -1, timer: 0, dwell: 20000, stepping: false };

const arrayPool = (p) => Array.isArray(p) && p.length > 0;

function cyclePool(around) {
  const v = around || state.view;
  const skip = state.selected ? state.selected.url : '';
  return state.stations
    .filter((s) => s.url && s.url !== skip && !state.deadUrls[s.url])
    .map((s) => ({ s, d: rowDistance(s, v.lat, v.lon) }))
    .sort((a, b) => a.d - b.d)
    .slice(0, 40)
    .map((x) => x.s);
}

function cycleTune() {
  if (!CYCLE.list.length) { cycleToggle(false); return; }
  CYCLE.idx++;
  if (CYCLE.idx >= CYCLE.list.length) {
    if (CYCLE.fixed) {
      CYCLE.idx = 0;                            // a saved list simply loops
    } else {                                    // out of stations here: carry on from the last one
      const last = CYCLE.list[CYCLE.list.length - 1];
      CYCLE.list = cyclePool({ lat: last.lat, lon: last.lon });
      CYCLE.idx = 0;
    }
    if (!CYCLE.list.length) { cycleToggle(false); return; }
  }
  const st = CYCLE.list[CYCLE.idx];
  CYCLE.stepping = true;
  tuneStation(st, CYCLE.list);
  CYCLE.stepping = false;
  toast(`Cycling ${CYCLE.idx + 1}/${CYCLE.list.length} \u00b7 ${st.name}`, 2600);
  clearTimeout(CYCLE.timer);
  CYCLE.timer = setTimeout(cycleTune, CYCLE.dwell);
}

function cycleToggle(force, pool) {
  const on = typeof force === 'boolean' ? force : !CYCLE.on;
  if (arrayPool(pool)) CYCLE.fixed = pool.slice(0);
  if (on === CYCLE.on) return;
  CYCLE.on = on;
  if (dom.btnCycle) dom.btnCycle.classList.toggle('active', on);
  if (on) {
    CYCLE.list = CYCLE.fixed ? CYCLE.fixed.slice() : cyclePool();
    CYCLE.idx = -1;
    if (CYCLE.fixed && state.selected) {        // start after whatever is playing
      const at = CYCLE.list.findIndex((x) => x.url === state.selected.url);
      if (at >= 0) CYCLE.idx = at;
    }
    if (!CYCLE.list.length) {
      CYCLE.on = false;
      if (dom.btnCycle) dom.btnCycle.classList.remove('active');
      toast('No working stations to cycle through around here.', 3000, true);
      return;
    }
    toast(`Cycling ${CYCLE.list.length} stations near here \u2014 every ${Math.round(CYCLE.dwell / 1000)} s. Press C to stop.`);
    cycleTune();
  } else {
    clearTimeout(CYCLE.timer); CYCLE.timer = 0;
    CYCLE.fixed = null;
    toast('Stopped cycling.');
  }
}

function cycleNext() {
  if (!CYCLE.on) { cycleToggle(true); return; }
  cycleTune();
}

/* ------------------------------------------------------------------ player */
const audio = new Audio();
audio.preload = 'auto';
audio.volume = 0.8;
let candidates = [], candidateIdx = 0, watchdog = 0, loadSeq = 0, tryId = 0, failHandled = 0;

function relayUrl(url) { return `api/stream?u=${encodeURIComponent(url)}`; }

function playableUrl(url) {
  // HTTP-only stations need the relay that the server provides. In a single file
  // there is nothing to relay through, so hand the URL over and let the browser try.
  if (HAS_BACKEND && isSecure && url.startsWith('http://')) return relayUrl(url);
  return url;
}

function setAudioState(s) {
  state.audioState = s;
  dom.card.classList.toggle('playing', s === 'playing');
  dom.card.classList.toggle('loading', s === 'loading');
  dom.eq.dataset.state = s === 'playing' ? 'playing' : s === 'paused' ? 'paused' : 'idle';
  dom.btnPlay.setAttribute('aria-label', s === 'playing' ? 'Pause' : 'Play');
}

function tuneStation(row, list) {
  if (!row) return;
  if (CYCLE.on && !CYCLE.stepping) cycleToggle(false);   // you took over the dial
  if (REC.on && state.selected !== row) recStop('Recording finished — the station changed.');
  state.selected = row;
  candidates = [];
  const pool = (list && list.length ? list : [row]).filter((s) => s.url);
  const primary = row;
  candidates.push(primary);
  const near = pool
    .filter((s) => s.url !== primary.url && !state.deadUrls[s.url])
    .sort((a, b) => rowDistance(a, primary.lat, primary.lon) - rowDistance(b, primary.lat, primary.lon))
    .slice(0, 5);
  candidates = candidates.concat(near);
  candidateIdx = 0;

  showCard(row);
  if (!isSecure) flyTo(row.lat, row.lon, Math.max(state.view.tZoom, 2.6));
  else flyTo(row.lat, row.lon, Math.max(state.view.tZoom, 2.2));
  lastBuildKey = '';

  const seq = ++loadSeq;
  attempt(seq);
}

function attempt(seq) {
  if (seq !== loadSeq) return;
  clearTimeout(watchdog);
  const row = candidates[candidateIdx];
  if (!row) return giveUp();
  const myTry = ++tryId;
  const current = () => myTry === tryId && seq === loadSeq;
  setAudioState('loading');
  const url = playableUrl(row.url);
  try { audio.pause(); } catch (e) { /* noop */ }
  audio.src = url;
  audio.load();

  watchdog = setTimeout(() => {
    if (current() && audio.readyState < 3) nextCandidate(seq);
  }, AUDIO_TIMEOUT);

  const p = audio.play();
  if (p && p.catch) p.catch((err) => {
    if (!current()) return;
    if (err && (err.name === 'NotAllowedError')) {
      setAudioState('paused');
      toast('Tap play when you are ready — browsers need a click before audio can start.');
      return;
    }
    nextCandidate(seq);
  });
}

function nextCandidate(seq) {
  if (seq !== loadSeq) return;
  if (failHandled === tryId) return;   // error + watchdog + stalled can all fire: advance once
  failHandled = tryId;
  const bad = candidates[candidateIdx];
  if (bad) { state.deadUrls[bad.url] = Date.now(); }
  candidateIdx++;
  if (candidateIdx < candidates.length) {
    toast(`That stream did not answer — trying “${esc(candidates[candidateIdx].name)}” nearby…`, 2600);
    lastBuildKey = '';
    attempt(seq);
  } else if (HAS_BACKEND && state.selected && !state.fetchTried) {
    state.fetchTried = true;
    toast('Looking for a live stream at this spot…', 2600);
    fetch(`api/nearby?lat=${state.selected.lat}&lon=${state.selected.lon}&km=300&limit=12`)
      .then((r) => r.json())
      .then((d) => {
        const rows = (d.stations || []).filter((s) => s.url && !state.deadUrls[s.url]);
        if (!rows.length) return giveUp();
        candidates = rows;
        candidateIdx = 0;
        attempt(seq);
      })
      .catch(() => giveUp());
  } else {
    giveUp();
  }
}

function giveUp() {
  setAudioState('error');
  toast('Nothing at that coordinate is answering right now. Try another light — a lot of small stations come and go.', 5200, true);
}

function showCard(row) {
  state.fetchTried = false;
  dom.card.hidden = false;
  dom.cardPlace.textContent = [flagEmoji(row.cc), shortCountry(row.country), row.state].filter(Boolean).join(' ').trim() || 'Radio';
  dom.cardName.textContent = row.name;
  const tags = (row.tags || '').split(',').map((t) => t.trim()).filter(Boolean).slice(0, 3);
  dom.cardTags.innerHTML = tags.map((t) => `<span>${esc(t)}</span>`).join('');
  const bits = [];
  if (row.codec) bits.push(row.codec + (row.bitrate ? ` · ${row.bitrate} kbps` : ''));
  if (row.votes) bits.push(`${row.votes} votes`);
  dom.cardMeta.textContent = bits.join(' · ');
  dom.cardSite.hidden = !row.homepage;
  if (row.homepage) dom.cardSite.href = row.homepage;

  const initials = (row.name.match(/[A-Za-z0-9]/g) || ['R', 'D']).slice(0, 2).join('').toUpperCase();
  dom.cardInitials.textContent = initials;
  const art = dom.cardArt.querySelector('img');
  if (art) art.remove();
  if (row.favicon && /^https?:\/\//.test(row.favicon)) {
    const img = new Image();
    img.referrerPolicy = 'no-referrer';
    img.decoding = 'async';
    img.onload = () => { dom.cardInitials.textContent = ''; dom.cardArt.appendChild(img); };
    img.onerror = () => img.remove();
    img.src = row.favicon;
  }
  syncFavButton();
  renderPanelListHighlight();
}

function renderPanelListHighlight() {
  const url = state.playing ? state.playing.url : null;
  for (const el of dom.list.querySelectorAll('.row')) {
    el.classList.toggle('playing', !!url && el.dataset.url === url);
  }
}

audio.addEventListener('playing', () => {
  clearTimeout(watchdog);
  state.playing = candidates[candidateIdx] || state.selected;
  setAudioState('playing');
  dom.search.blur();
  lastBuildKey = '';
  const r = state.playing;
  if (r) {
    state.clickCounts[r.url] = (state.clickCounts[r.url] || 0) + 1;
    if (r.id && HAS_BACKEND) {
      fetch(`https://de1.api.radio-browser.info/json/url/${encodeURIComponent(r.id)}`, {
        method: 'POST', mode: 'cors', keepalive: true
      }).catch(() => {});
    }
    showCard(r);
  }
});
audio.addEventListener('pause', () => { if (state.audioState !== 'loading') setAudioState('paused'); });
audio.addEventListener('waiting', () => { if (state.audioState === 'playing') dom.eq.dataset.state = 'playing'; });
audio.addEventListener('error', () => {
  const seq = loadSeq;
  if (state.audioState === 'loading' || state.audioState === 'playing') nextCandidate(seq);
});
audio.addEventListener('stalled', () => {
  const seq = loadSeq, myTry = tryId;
  setTimeout(() => {
    if (seq === loadSeq && myTry === tryId && audio.readyState < 3) nextCandidate(seq);
  }, 4000);
});

/* ------------------------------------------------------------------ recording */
/* The ● button keeps a copy of the stream you are listening to. Browsers refuse to capture
   a cross-origin <audio> element, so instead of re-encoding what comes out of the speakers
   we read the stream itself — through the little server when it is running, which sidesteps
   cross-origin rules entirely — and save the bytes unchanged: the recording is the station's
   own audio, bit for bit. Personal listening only; the music stays the stations'. */
const REC = { on: false, chunks: [], bytes: 0, started: 0, timer: 0, name: '', type: '',
              abort: null, stopping: false, last: null, note: '' };
const REC_MAX = 400 * 1024 * 1024;      // ~7 hours of 128 kbps — a guard, not a policy

const REC_TYPES = [['audio/mpeg', 'mp3'], ['audio/mp3', 'mp3'], ['audio/aacp', 'aac'],
                   ['audio/aac', 'aac'], ['audio/ogg', 'ogg'], ['application/ogg', 'ogg'],
                   ['audio/webm', 'webm'], ['audio/mp4', 'm4a'], ['audio/flac', 'flac'],
                   ['audio/x-flac', 'flac'], ['audio/opus', 'opus']];

function recExt(type, url = '') {
  const t = (type || '').toLowerCase();
  for (const [needle, ext] of REC_TYPES) if (t.includes(needle)) return ext;
  const m = /\.(mp3|aac|m4a|ogg|oga|opus|webm|flac)(\?|$)/i.exec(url || '');
  return m ? m[1].toLowerCase() : 'mp3';
}

function recClock() {
  if (!dom.recTime) return;
  const secs = Math.floor((Date.now() - REC.started) / 1000);
  const mb = REC.bytes / 1048576;
  dom.recTime.textContent = `${String(Math.floor(secs / 60)).padStart(2, '0')}:${String(secs % 60).padStart(2, '0')}` +
                            (mb >= 0.05 ? ` · ${mb.toFixed(1)} MB` : '');
}

function download(name, blob) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = name;
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 8000);
}

function recFail(msg) {
  REC.on = false;
  clearInterval(REC.timer); REC.timer = 0;
  if (dom.btnRec) { dom.btnRec.classList.remove('recording'); dom.btnRec.title = 'Record what you hear'; }
  if (dom.recTime) dom.recTime.hidden = true;
  toast(msg, 7000, true);
}

async function recStart() {
  const st = state.selected;
  if (!st) { toast('Tune a station first, then record it.', 3200, true); return; }
  if (REC.on) return;

  const through = HAS_BACKEND;
  const target = through ? relayUrl(st.url) : st.url;
  REC.abort = new AbortController();
  REC.stopping = false;

  let res;
  try {
    res = await fetch(target, {
      signal: REC.abort.signal, credentials: 'omit', cache: 'no-store',
      mode: through ? 'same-origin' : 'cors'
    });
  } catch (e) {
    recFail(through
      ? 'Could not reach that station to record it.'
      : 'Recording here needs the little server: most stations do not allow a page opened from a file to read their stream. Run python3 server.py 8000 and record from there.');
    return;
  }

  const type = (res.headers.get('content-type') || '').toLowerCase();
  if (!res.ok || !res.body || /text\/|mpegurl|scpls|xml|json/.test(type)) {
    recFail(/text\/|mpegurl|scpls/.test(type)
      ? 'That station hands out a playlist rather than audio, so there is nothing to copy.'
      : 'That station would not give up its stream.');
    return;
  }

  REC.type = type;
  REC.name = st.name || 'station';
  REC.chunks = [];
  REC.bytes = 0;
  REC.started = Date.now();
  REC.on = true;
  if (dom.btnRec) { dom.btnRec.classList.add('recording'); dom.btnRec.title = 'Stop recording'; }
  if (dom.recTime) { dom.recTime.hidden = false; }
  recClock();
  REC.timer = setInterval(recClock, 1000);
  toast(`Recording ${REC.name} — press ● again to finish.`, 4200);

  const reader = res.body.getReader();
  try {
    for (;;) {
      const { done, value } = await reader.read();
      if (done) break;
      if (value && value.length) { REC.chunks.push(value); REC.bytes += value.length; }
      if (REC.bytes >= REC_MAX) { toast('That is a big recording — saving it here so memory stays sane.', 5000, true); recStop(); break; }
    }
  } catch (e) { /* we aborted it ourselves on stop — normal */ }
  if (REC.on && !REC.stopping) recStop('The stream ended — recording saved what it had.');
}

function recStop(msg) {
  if (!REC.on) return;
  REC.on = false;
  REC.stopping = true;
  clearInterval(REC.timer); REC.timer = 0;
  if (dom.btnRec) { dom.btnRec.classList.remove('recording'); dom.btnRec.title = 'Record what you hear'; }
  if (dom.recTime) dom.recTime.hidden = true;
  try { if (REC.abort) REC.abort.abort(); } catch (e) { /* already closed */ }

  const secs = Math.max(1, Math.round((Date.now() - REC.started) / 1000));
  const blob = new Blob(REC.chunks, { type: REC.type || 'audio/mpeg' });
  if (!blob.size) { toast('Nothing came through, so there is no file to save.', 4200, true); return; }
  const when = new Date().toISOString().slice(0, 16).replace('T', ' ').replace(':', 'h');
  const safe = REC.name.replace(/[^\w \-.]+/g, '').trim().slice(0, 60) || 'station';
  REC.last = { name: `HERMANOS RADIO - ${safe} - ${when}.${recExt(REC.type, state.selected && state.selected.url)}`,
               bytes: blob.size, seconds: secs, type: REC.type };
  download(REC.last.name, blob);
  REC.chunks = [];
  toast(`${msg ? msg + ' ' : ''}Saved ${Math.round(blob.size / 1024)} KB of ${REC.name}.`, 6000);
}

function recToggle() { if (REC.on) recStop('Recording stopped.'); else recStart(); }

/* a favourites list is a playlist: cycle it, or hand it to any other player */
function buildM3U() {
  const lines = ['#EXTM3U', '# HERMANOS RADIO — saved stations',
                 `# exported ${new Date().toISOString().slice(0, 10)}`];
  for (const f of state.faves) {
    lines.push(`#EXTINF:-1,${f.name}${f.country ? ` — ${f.country}` : ''}`);
    lines.push(f.url);
  }
  return lines.join('\n') + '\n';
}

function exportFaves() {
  if (!state.faves.length) { toast('Nothing saved yet.', 3000, true); return; }
  download('hermanos-radio-favourites.m3u', new Blob([buildM3U()], { type: 'audio/x-mpegurl' }));
  toast(`Saved a playlist of ${state.faves.length} stations (.m3u).`, 4200);
}

/* ------------------------------------------------------------------ cards & tools */
function togglePlay() {
  if (!state.selected) {
    surprise();
    return;
  }
  if (state.audioState === 'playing') { audio.pause(); setAudioState('paused'); return; }
  if (state.audioState === 'paused' && audio.src) {
    setAudioState('loading');
    audio.play().catch(() => { attempt(++loadSeq); });
    return;
  }
  attempt(++loadSeq);
}

function loadFaves() {
  try {
    const raw = JSON.parse(localStorage.getItem(FAVES_KEY) || '[]');
    state.faves = Array.isArray(raw) ? raw : [];
    if (!state.faves.length) {
      // carry over a list saved before the rebrand
      const old = JSON.parse(localStorage.getItem(FAVES_KEY_OLD) || '[]');
      if (Array.isArray(old) && old.length) {
        state.faves = old;
        saveFaves();
      }
    }
  } catch (e) { state.faves = []; }
}
function saveFaves() {
  try { localStorage.setItem(FAVES_KEY, JSON.stringify(state.faves.slice(0, 200))); } catch (e) { /* full */ }
}
function isFave(url) { return state.faves.some((f) => f.url === url); }
function toggleFav() {
  const row = state.selected;
  if (!row) { toast('Tune a station first, then tap the heart.'); return; }
  if (isFave(row.url)) {
    state.faves = state.faves.filter((f) => f.url !== row.url);
    toast('Removed from your stations.');
  } else {
    state.faves.unshift({ id: row.id, name: row.name, country: row.country, cc: row.cc, state: row.state,
      tags: row.tags, codec: row.codec, bitrate: row.bitrate, votes: row.votes,
      homepage: row.homepage, favicon: row.favicon, lat: row.lat, lon: row.lon, url: row.url });
    toast('Saved. Find it behind the heart in the top bar.');
  }
  saveFaves();
  syncFavButton();
  lastBuildKey = '';
  if (state.panelMode === 'faves') openPanel('faves');
}
function syncFavButton() {
  const on = state.selected && isFave(state.selected.url);
  dom.btnFav.classList.toggle('on', !!on);
}

function surprise() {
  const pool = state.stations.slice(0, Math.min(4200, state.stations.length));
  let s = null;
  for (let i = 0; i < 12 && !s; i++) {
    const cand = pool[Math.floor(Math.random() * pool.length)];
    if (!state.deadUrls[cand.url] && cand.url) s = cand;
  }
  if (!s) return toast('No playable stations in the atlas.', 3000, true);
  tuneStation(s);
  toast(`${flagEmoji(s.cc)} ${esc(s.country || 'Somewhere')} · ${esc(s.name)}`, 3600);
}

/* ------------------------------------------------------------------ search */
let searchDebounce = 0, suggestList = [], suggestIdx = -1, suggestTerm = '';

function localSearch(term) {
  const q = term.toLowerCase().trim();
  if (q.length < 2) return { stations: [], countries: [], genres: [] };
  const stations = [], countries = [], genres = [];
  const seenGenre = new Map();
  for (const c of state.countries) {
    if (c.name.toLowerCase().startsWith(q)) countries.push({ kind: 'country', cc: c.cc, name: c.name, count: c.count, lat: c.lat, lon: c.lon });
  }
  for (const s of state.stations) {
    if (stations.length > 60) break;
    const n = s.name.toLowerCase();
    if (n.startsWith(q) || n.includes(q)) { stations.push(s); continue; }
    if (s.tags && s.tags.toLowerCase().includes(q)) {
      for (const t of s.tags.split(',')) {
        const tt = t.trim();
        if (tt && tt.toLowerCase().includes(q) && !seenGenre.has(tt.toLowerCase()) && tt.length < 22) {
          seenGenre.set(tt.toLowerCase(), true);
          genres.push({ kind: 'genre', name: tt });
        }
      }
    }
  }
  return { stations: stations.slice(0, 12), countries: countries.slice(0, 5), genres: genres.slice(0, 5) };
}

function onSearchInput() {
  const term = dom.search.value.trim();
  if (term.length < 2) { dom.suggest.hidden = true; clearTimeout(searchDebounce); return; }
  const loc = localSearch(term);
  suggestList = [...loc.countries, ...loc.genres, ...loc.stations.map((s) => ({ kind: 'station', s }))];
  suggestIdx = suggestList.length ? 0 : -1;
  renderSuggest(term);
  suggestTerm = term;
  state.searchHits = loc.stations.map((s) => s);
  lastBuildKey = '';
  clearTimeout(searchDebounce);
  searchDebounce = setTimeout(() => runSearch(term, false), 420);
}

function renderSuggest(term) {
  if (!suggestList.length) {
    dom.suggest.hidden = true; return;
  }
  dom.suggest.innerHTML = suggestList.map((it, i) => {
    if (it.kind === 'station') {
      const s = it.s;
      return `<button data-i="${i}" class="${i === suggestIdx ? 'active' : ''}">
        <span class="s-kind">FM</span>
        <span class="s-name">${esc(s.name)}</span>
        <span class="s-meta">${flagEmoji(s.cc)} ${esc(s.country || '')}</span></button>`;
    }
    if (it.kind === 'country') {
      return `<button data-i="${i}" class="${i === suggestIdx ? 'active' : ''}">
        <span class="s-kind">Country</span>
        <span class="s-name">${flagEmoji(it.cc)} ${esc(shortCountry(it.name))}</span>
        <span class="s-meta">${it.count} stations</span></button>`;
    }
    return `<button data-i="${i}" class="${i === suggestIdx ? 'active' : ''}">
      <span class="s-kind">Genre</span>
      <span class="s-name">${esc(it.name)}</span><span class="s-meta">tag</span></button>`;
  }).join('');
  dom.suggest.hidden = false;
  for (const b of dom.suggest.querySelectorAll('button')) {
    b.addEventListener('mousedown', (e) => { e.preventDefault(); pickSuggest(parseInt(b.dataset.i, 10)); });
  }
}

function pickSuggest(i) {
  const it = suggestList[i];
  if (!it) return;
  if (it.kind === 'station') {
    dom.search.value = it.s.name;
    state.searchHits = [it.s];
    lastBuildKey = '';
    tuneStation(it.s);
  } else if (it.kind === 'country') {
    dom.search.value = it.name;
    openPanel('country', { cc: it.cc, name: it.name, count: it.count, lat: it.lat, lon: it.lon });
  } else {
    dom.search.value = it.name;
    openPanel('genre', { name: it.name });
  }
  dom.suggest.hidden = true;
}

/* search straight out of the atlas: no network, but the whole 11k station index */
/* Atlas matches, best first. The atlas tags carry the city and country name, so a
   search for "Kampala" or "Uganda" reaches the stations placed there. */
function atlasMatches(term, limit) {
  const q = term.toLowerCase().trim();
  if (!q) return [];
  return state.stations
    .map((s) => {
      const name = s.name.toLowerCase();
      const tags = (s.tags || '').toLowerCase();
      const country = (s.country || '').toLowerCase();
      let score = 0;
      if (name === q) score = 6;
      else if (name.startsWith(q)) score = 5;
      else if (name.includes(q)) score = 4;
      else if (tags.includes(q)) score = 3;
      else if (country.includes(q)) score = 1;
      return score ? { s, score } : null;
    })
    .filter(Boolean)
    .sort((a, b) => b.score - a.score || b.s.votes - a.s.votes)
    .slice(0, limit || 60)
    .map((x) => x.s);
}

function localSearchPanel(term, quiet) {
  const rows = atlasMatches(term, 60);
  if (!rows.length) {
    if (!quiet) toast(`Nothing in the offline atlas matches “${esc(term)}”.`, 4000);
    return;
  }
  state.searchHits = rows;
  lastBuildKey = '';
  if (!quiet) {
    const near = rows[0];
    flyTo(near.lat, near.lon, Math.max(state.view.tZoom, 2.4));
    openPanel('search', { term, rows });
  }
}

async function runSearch(term, fromBtn) {
  if (!term || !term.trim()) { dom.search.focus(); return; }
  if (fromBtn) dom.search.value = term;
  if (!HAS_BACKEND) { localSearchPanel(term, false); return; }
  try {
    const r = await fetch(`api/search?q=${encodeURIComponent(term)}&limit=60`);
    const data = await r.json();
    if (data.error) throw new Error(data.error);
    const local = atlasMatches(term, 60);
    const seen = new Set(local.map((s) => (s.url || '').replace(/\/+$/, '').toLowerCase()));
    const live = (data.stations || [])
      .filter((s) => s.lat && s.lon)
      .filter((s) => !seen.has((s.url || '').replace(/\/+$/, '').toLowerCase()));
    const rows = local.concat(live).slice(0, 60);
    if (!rows.length) {
      toast(`Nothing matches “${esc(term)}” — not in the atlas, not in the live directory. Try a bigger city, a country or a genre — or just wander the map.`, 5200);
      return;
    }
    state.searchHits = rows;
    lastBuildKey = '';
    const near = rows[0];
    flyTo(near.lat, near.lon, Math.max(state.view.tZoom, 2.4));
    openPanel('search', { term, rows });
  } catch (e) {
    toast('Live search is unavailable right now (the directory may be down). Local matches are already glowing gold.', 4200, true);
  }
}

function onSearchKey(e) {
  if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
    if (!suggestList.length) return;
    e.preventDefault();
    suggestIdx = (suggestIdx + (e.key === 'ArrowDown' ? 1 : -1) + suggestList.length) % suggestList.length;
    renderSuggest(dom.search.value);
  } else if (e.key === 'Enter') {
    e.preventDefault();
    const live = suggestList.length && suggestTerm !== dom.search.value.trim();
    if (live) runSearch(dom.search.value, false);
    else if (suggestList.length && suggestIdx >= 0) pickSuggest(suggestIdx);
    else runSearch(dom.search.value, false);
    dom.suggest.hidden = true;
  } else if (e.key === 'Escape') {
    dom.suggest.hidden = true;
    dom.search.blur();
  }
}

/* ------------------------------------------------------------------ wiring */
function bindUI() {
  $('brand').addEventListener('click', (e) => {
    e.preventDefault();
    state.countryFilter = null;
    lastBuildKey = '';
    resetFit();
    dom.panel.hidden = true;
  });
  $('panel-close').addEventListener('click', () => {
    dom.panel.hidden = true;
    dom.card.classList.remove('has-panel');
    if (state.panelMode === 'country') { state.countryFilter = null; lastBuildKey = ''; }
    state.panelMode = null;
  });
  $('btn-faves').addEventListener('click', () => {
    if (!state.faves.length) {
      toast('No saved stations yet. Tune something and tap the heart on the player.');
      return;
    }
    if (state.panelMode === 'faves') { dom.panel.hidden = true; state.panelMode = null; return; }
    openPanel('faves');
  });
  $('btn-random').addEventListener('click', surprise);
  if (dom.btnCycle) dom.btnCycle.addEventListener('click', () => cycleToggle());
  if (dom.btnRec) dom.btnRec.addEventListener('click', recToggle);
  if (dom.btnSat) dom.btnSat.addEventListener('click', () => toggleSatellite());
  $('btn-info').addEventListener('click', () => { dom.modal.hidden = false; });
  $('modal-close').addEventListener('click', () => { dom.modal.hidden = true; });
  dom.modal.addEventListener('click', (e) => { if (e.target === dom.modal) dom.modal.hidden = true; });
  dom.btnPlay.addEventListener('click', togglePlay);
  dom.btnFav.addEventListener('click', toggleFav);
  dom.btnMute.addEventListener('click', () => { audio.muted = !audio.muted; dom.btnMute.parentElement.classList.toggle('muted', audio.muted); });
  dom.btnFit.addEventListener('click', resetFit);
  dom.volume.addEventListener('input', () => {
    audio.volume = clamp(parseFloat(dom.volume.value), 0, 1);
    dom.volume.style.setProperty('--v', `${Math.round(audio.volume * 100)}%`);
    audio.muted = audio.volume === 0;
    dom.btnMute.parentElement.classList.toggle('muted', audio.muted);
  });
  dom.volume.style.setProperty('--v', '80%');
  dom.btnMute.parentElement.classList.toggle('muted', audio.muted || audio.volume === 0);

  dom.search.addEventListener('input', onSearchInput);
  dom.search.addEventListener('keydown', onSearchKey);
  dom.search.addEventListener('focus', () => { if (dom.search.value.trim().length > 1) onSearchInput(); });
  document.addEventListener('click', (e) => {
    if (!dom.searchWrap.contains(e.target)) dom.suggest.hidden = true;
  });

  document.addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA)$/.test(document.activeElement && document.activeElement.tagName);
    if (e.key === '/' && !typing) { e.preventDefault(); dom.search.focus(); dom.search.select(); return; }
    if (e.key === 'Escape') {
      dom.modal.hidden = true; dom.suggest.hidden = true;
      if (CYCLE.on) cycleToggle(false);
      if (REC.on) recStop('Recording stopped.');
      if (typing) dom.search.blur();
      return;
    }
    if (e.key === 'r' && !typing) { surprise(); return; }
    if (e.key === 's' && !typing) { toggleSatellite(); return; }
    if (e.key === 'c' && !typing) { cycleToggle(); return; }
    if (e.key === 'n' && !typing) { cycleNext(); return; }
    if (!typing && (e.key === 'ArrowLeft' || e.key === 'ArrowRight' || e.key === 'ArrowUp' || e.key === 'ArrowDown')) {
      e.preventDefault();
      const v = state.view;
      const stepDeg = degViewHeight(v.tZoom) * (e.shiftKey ? 0.5 : 0.16);
      if (e.key === 'ArrowLeft') v.tLon -= stepDeg;
      if (e.key === 'ArrowRight') v.tLon += stepDeg;
      if (e.key === 'ArrowUp') v.tLat += stepDeg;
      if (e.key === 'ArrowDown') v.tLat -= stepDeg;
      clampView();
      return;
    }
    if (!typing && (e.key === '+' || e.key === '=' || e.key === '-' || e.key === '_')) {
      e.preventDefault();
      const factor = (e.key === '+' || e.key === '=') ? 1.35 : 1 / 1.35;
      const v = state.view;
      const halfH = degViewHeight(clamp(v.tZoom * factor, MIN_ZOOM, MAX_ZOOM)) / 2;
      const halfW = halfH * (window.innerWidth / Math.max(1, window.innerHeight));
      v.tZoom = v.zoom = clamp(v.tZoom * factor, MIN_ZOOM, MAX_ZOOM);
      v.tLon = v.lon = clamp(v.tLon, -Math.max(0, 180 - halfW * 0.6), Math.max(0, 180 - halfW * 0.6));
      v.tLat = v.lat = clamp(v.tLat, -Math.max(0, 90 - halfH * 0.6), Math.max(0, 90 - halfH * 0.6));
      clampView();
      return;
    }
    if (e.code === 'Space' && !typing) { e.preventDefault(); togglePlay(); return; }
    if (e.key === 'm' && !typing) { audio.muted = !audio.muted; dom.btnMute.parentElement.classList.toggle('muted', audio.muted); }
  });

  $('btn-here').addEventListener('click', locateMe);

  window.addEventListener('online', () => { state.online = true; });
  window.addEventListener('offline', () => { state.online = false; toast('You are offline — the offline atlas still works.', 3000, true); });
}

function locateMe() {
  if (!navigator.geolocation) { toast('This browser will not share a location.', 3200, true); return; }
  toast('Asking your browser where you are…', 2600);
  navigator.geolocation.getCurrentPosition((pos) => {
    const { latitude: lat, longitude: lon } = pos.coords;
    flyTo(lat, lon, 6.5);
    openPanel('nearby', { lat, lon, label: 'Your neighbourhood' });
    toast('Here you are. These are the stations around you.', 4000);
  }, (err) => {
    const why = err && err.code === 1 ? 'Location permission was declined.'
      : err && err.code === 3 ? 'Location lookup timed out.'
      : 'No location available.';
    toast(`${why} Click anywhere on the map instead.`, 4200, true);
  }, { enableHighAccuracy: false, timeout: 9000, maximumAge: 600000 });
}

/* ------------------------------------------------------------------ boot */
async function boot() {
  loadFaves();
  const steps = [
    ['drawing the world', 'painting coastlines, land and the graticule'],
    ['tuning the atlas', 'loading 10,000+ geolocated stations'],
    ['wiring the dial', 'connecting the live directory']
  ];
  let i = 0;
  const nextStep = setInterval(() => {
    i = (i + 1) % steps.length;
    dom.bootText.textContent = `${steps[i][0]}…`;
    dom.bootSub.textContent = steps[i][1];
  }, 900);

  buildScene();

  let atlas = null, world = null;
  if (EMBEDDED) {
    atlas = EMBEDDED.atlas;
    world = EMBEDDED.world;
  } else {
    try {
      const [a, w] = await Promise.all([
        fetch('api/stations').then((r) => r.json()),
        fetch('static/data/world.json').then((r) => r.json())
      ]);
      atlas = a; world = w;
    } catch (e) {
      clearInterval(nextStep);
      dom.bootText.textContent = 'could not reach the station atlas';
      dom.bootSub.textContent = 'Make sure the server is running and reload the page.';
      return;
    }
  }
  clearInterval(nextStep);

  const keys = atlas.keys || ['n', 'c', 'cc', 'k', 'b', 'v', 'g', 'f', 'y', 'x', 'u'];
  state.stations = atlas.stations.map((row) => {
    const o = {};
    keys.forEach((k, idx) => { o[k] = row[idx]; });
    return {
      name: o.n, country: o.c, cc: o.cc, codec: o.k, bitrate: o.b, votes: o.v,
      tags: o.g, favicon: o.f, lat: o.y, lon: o.x, url: o.u,
      key: `${o.n}|${o.y}|${o.x}`
    };
  }).filter((s) => s.lat != null && s.lon != null && s.url);

  setWorldCoastlines(world);
  buildClusters();
  state.searchHits = [];
  lastBuildKey = '';
  rebuildPoints(true);
  bindMapInput();
  bindUI();

  dom.boot.classList.add('done');
  setTimeout(() => { dom.boot.hidden = true; }, 600);
  requestAnimationFrame(tick);

  if (IS_STANDALONE) dom.search.placeholder = 'Search a city, country, station or genre…';
  setTimeout(() => {
    if (state.selected) return;
    const small = window.innerWidth < 820;
    toast(small
      ? 'Tap a light to hear that city'
      : 'Tap any glowing light to tune in a city · press <kbd>R</kbd> for a random station',
      small ? 4200 : 6500);
  }, 1200);

  // handy for debugging from the console (and for automated tests)
  window.__hermanos = {
    state, tuneStation, flyTo, openPanel, surprise, runSearch, audio, resetFit,
    cycleToggle, cycleNext, exportFaves, recToggle,
    record: () => ({ on: REC.on, seconds: REC.on ? Math.round((Date.now() - REC.started) / 1000) : 0,
                     bytes: REC.bytes, type: REC.type, chunks: REC.chunks.length,
                     last: REC.last, clock: dom.recTime ? dom.recTime.textContent : '',
                     station: REC.name, viaServer: HAS_BACKEND }),
    favesM3U: buildM3U,
    cycle: () => ({ on: CYCLE.on, idx: CYCLE.idx, len: CYCLE.list.length, dwell: CYCLE.dwell,
                    name: CYCLE.list[CYCLE.idx] ? CYCLE.list[CYCLE.idx].name : '',
                    playing: (state.selected && state.selected.name) || '' }),
    toggleSatellite, sat: () => ({
      on: SAT.on, date: SAT.date, zoom: satLevel(), span: satGrid(satLevel()).span,
      tiles: SAT.tiles.size, loaded: [...SAT.tiles.values()].filter((m) => m.userData.loaded).length,
      requests: SAT.requests, failed: SAT.failed,
      visible: SAT.group ? SAT.group.visible : false,
      mapOpacity: mapPlane ? mapPlane.material.opacity : -1,
      lines: worldLines && worldLines.material.blending === THREE.NormalBlending ? 'normal' : 'additive',
      chip: dom.satCredit ? (dom.satCredit.hidden ? '' : dom.satCredit.textContent) : '',
      view: { lon: state.view.lon, lat: state.view.lat, halfW: mapHalfW, halfH: mapHalfH },
      cover: (() => {
        let lon0 = 999, lon1 = -999, lat0 = 999, lat1 = -999, n = 0;
        SAT.tiles.forEach((m) => {
          const w = m.geometry.parameters.width / 2, h = m.geometry.parameters.height / 2;
          lon0 = Math.min(lon0, m.position.x - w); lon1 = Math.max(lon1, m.position.x + w);
          lat0 = Math.min(lat0, m.position.y - h); lat1 = Math.max(lat1, m.position.y + h);
          n++;
        });
        return n ? { lon0, lon1, lat0, lat1, n } : null;
      })()
    }),
    clusters: () => state.clusters.length, drawn: () => pointCount,
    level: () => levelIndex, visible: () => [mapHalfW, mapHalfH]
  };

  // deep links: #s=<station name>, and #lat,lon,z to open on a spot
  applyDeepLink();
  window.addEventListener('hashchange', applyDeepLink);
}

/* Shareable links. #s=jazz picks the best name match; #1.94,30.06,12 opens on a place. */
function applyDeepLink() {
  const hash = location.hash || '';
  const m = /#s=([^&]+)/.exec(hash);
  if (m) {
    const term = decodeURIComponent(m[1]).toLowerCase().trim();
    if (!term) return;
    const hit = state.stations.find((s) => s.name.toLowerCase() === term) ||
      state.stations.find((s) => s.name.toLowerCase().includes(term));
    if (hit) {
      state.selected = hit;
      showCard(hit);
      flyTo(hit.lat, hit.lon, Math.max(6, state.view.tZoom));
      toast(`Loaded “${esc(hit.name)}” — press space or the play button.`);
    } else {
      toast(`No station in the atlas matches “${esc(term)}”. Try search instead.`, 4200);
    }
    return;
  }
  const g = /#(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)(?:,(\d+(?:\.\d+)?))?/.exec(hash);
  if (g) {
    const lat = parseFloat(g[1]), lon = parseFloat(g[2]);
    const zoom = g[3] ? parseFloat(g[3]) : 6;
    if (isFinite(lat) && isFinite(lon)) {
      flyTo(lat, lon, clamp(zoom, MIN_ZOOM, MAX_ZOOM));
      openPanel('nearby', { lat, lon, label: '' });
    }
  }
}

if (!window.WebGLRenderingContext) {
  dom.bootText.textContent = 'this browser has no WebGL';
  dom.bootSub.textContent = 'The map needs WebGL. Try a desktop browser or a newer phone.';
} else {
  try {
    boot();
  } catch (e) {
    dom.bootText.textContent = 'something went wrong while booting';
    dom.bootSub.textContent = String(e && e.message || e);
  }
}
})();

